<div style="font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background-color:#020617; color:#e2e8f0; padding:24px;">
  <div style="max-width:480px;margin:0 auto;border-radius:20px;border:1px solid #1f2937;background:#020617;padding:32px;">

    <!-- Header / logo -->
    <div style="text-align:center;margin-bottom:20px;">
      <%= link_to main_app.root_url do %>
        <%= image_tag "logo.svg",
              alt: "Barnaboll",
              style: "height:48px;width:auto;border-radius:12px;box-shadow:0 0 12px rgba(255,145,0,0.4);" %>
      <% end %>

      <h1 style="font-size:22px;margin:16px 0 6px;color:#f9fafb;">
        Du har lagts till i ett lag
      </h1>

      <p style="font-size:13px;color:#94a3b8;margin:0;">
        <strong><%= @creator.name_or_email %></strong> har lagt till dig i laget
        <strong><%= @team.name %></strong> på Barnaboll.
      </p>
    </div>

    <!-- Main CTA -->
    <div style="text-align:center;margin:30px 0;">
      <%= link_to "Visa laget",
                  user_team_url(@team),
                  style: "
                    display:inline-block;
                    padding:12px 22px;
                    border-radius:999px;
                    background:linear-gradient(to right,#fb923c,#ec4899);
                    color:#020617;
                    font-size:14px;
                    font-weight:600;
                    text-decoration:none;
                  " %>
    </div>

    <!-- Info text -->
    <p style="font-size:13px;color:#cbd5f5;margin:0 0 16px;text-align:center;">
      Där kan du se andra medlemmar, kommande matcher och lagets statistik.
    </p>

    <!-- Footer -->
    <hr style="border:none;border-top:1px solid #1f2937;margin:24px 0 16px;">

    <div style="font-size:11px;color:#64748b;text-align:center;line-height:1.6;">
      <p style="margin:0 0 8px;">
        Barnaboll · Organisera och hantera barnens sportaktiviteter.
      </p>

      <p style="margin:0;">
        <%= link_to "Om Barnaboll", about_url,
                    style: "color:#e5e7eb;text-decoration:none;margin:0 6px;" %> ·
        <%= link_to "Integritet", privacy_url,
                    style: "color:#e5e7eb;text-decoration:none;margin:0 6px;" %> ·
        <%= link_to "Villkor", terms_url,
                    style: "color:#e5e7eb;text-decoration:none;margin:0 6px;" %> ·
        <%= link_to "Kontakt", contact_url,
                    style: "color:#e5e7eb;text-decoration:none;margin:0 6px;" %>
      </p>
    </div>

  </div>
</div>
