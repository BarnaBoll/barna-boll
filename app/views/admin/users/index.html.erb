<% content_for :title, "Admin – Användare" %>
<% content_for :meta_description, "Lista och hantering av användare i Barnaboll admin." %>

<div class="min-h-[calc(100vh-5rem)] bg-slate-950 text-slate-50">
  <div class="max-w-6xl mx-auto px-4 py-8 space-y-6">
    <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <p class="text-[11px] uppercase tracking-[0.2em] text-orange-300 mb-1">
          Admin
        </p>
        <h1 class="text-2xl font-semibold tracking-tight">Användare</h1>
        <p class="text-sm text-slate-400">
          Hantera communityn – se, skapa, uppdatera och ta bort användare.
        </p>
      </div>

      <%= link_to "Ny användare",
                  new_admin_user_path,
                  class: "inline-flex items-center justify-center rounded-full px-5 py-2.5 text-xs sm:text-sm font-semibold text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 shadow-lg shadow-orange-900/40 hover:from-orange-300 hover:to-pink-400 transition" %>
    </header>

    <% if @users.any? %>
      <div class="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-950/70">
        <table class="min-w-full text-sm">
          <thead class="bg-slate-950/80 border-b border-slate-800 text-[11px] uppercase tracking-[0.18em] text-slate-500">
            <tr>
              <th class="px-4 py-3 text-left">Namn</th>
              <th class="px-4 py-3 text-left">E-post</th>
              <th class="px-4 py-3 text-left">Admin</th>
              <th class="px-4 py-3 text-left">Bekräftad</th>
              <th class="px-4 py-3 text-left">Inloggningar</th>
              <th class="px-4 py-3 text-right">Åtgärder</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800">
            <% @users.each do |user| %>
              <tr>
                <td class="px-4 py-3 align-top">
                  <p class="font-medium text-slate-50"><%= user.name %></p>
                </td>
                <td class="px-4 py-3 align-top text-slate-300">
                  <%= user.email %>
                </td>
                <td class="px-4 py-3 align-top">
                  <% if user.admin? %>
                    <span class="inline-flex items-center rounded-full border border-orange-400/60 bg-orange-500/10 px-2.5 py-0.5 text-[11px] text-orange-300">
                      Admin
                    </span>
                  <% else %>
                    <span class="text-[11px] text-slate-400">Nej</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 align-top">
                  <% if user.confirmed_at.present? %>
                    <span class="text-[11px] text-emerald-300">Ja</span>
                  <% else %>
                    <span class="text-[11px] text-slate-400">Nej</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 align-top text-[11px] text-slate-400">
                  <%= user.sign_in_count %>
                </td>
                <td class="px-4 py-3 align-top">
                  <div class="flex justify-end gap-2">
                    <%= link_to "Visa",
                                admin_user_path(user),
                                class: "text-[11px] rounded-full border border-slate-700 px-3 py-1 hover:border-pink-400 hover:text-pink-300" %>
                    <%= link_to "Redigera",
                                edit_admin_user_path(user),
                                class: "text-[11px] rounded-full border border-slate-700 px-3 py-1 hover:border-pink-400 hover:text-pink-300" %>
                    <%= button_to "Ta bort",
                                  admin_user_path(user),
                                  method: :delete,
                                  data: { confirm: "Är du säker på att du vill ta bort den här användaren?" },
                                  class: "text-[11px] rounded-full border border-red-500/60 px-3 py-1 text-red-300 hover:bg-red-500/10" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-slate-400">Inga användare hittades.</p>
    <% end %>
  </div>
</div>
