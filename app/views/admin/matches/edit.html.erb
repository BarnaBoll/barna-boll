<% content_for :title, "Admin – Redigera match #{@match.title}" %>
<% content_for :meta_description, "Redigera matchen #{@match.title} i admin." %>

<div class="min-h-[calc(100vh-5rem)] bg-slate-950 text-slate-50">
  <div class="max-w-4xl mx-auto px-4 py-8 space-y-6">
    <header>
      <p class="text-[11px] uppercase tracking-[0.2em] text-orange-300 mb-1">
        Admin · Matcher
      </p>
      <h1 class="text-2xl font-semibold tracking-tight">
        Redigera match
      </h1>
      <p class="text-sm text-slate-400">
        Uppdatera info, datum, plats eller kapacitet.
      </p>
    </header>

    <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4">
      <%= render "form" %>
    </div>
  </div>
</div>
