<div style="font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background-color:#020617; color:#e2e8f0; padding:24px;">
  <div style="max-width:480px;margin:0 auto;border-radius:20px;border:1px solid #1f2937;background:#020617;padding:32px;">

    <div style="text-align:center;margin-bottom:20px;">
      <%= link_to main_app.root_url do %>
        <%= image_tag "logo.svg",
              alt: "Barnaboll",
              style: "height:48px;width:auto;border-radius:12px;box-shadow:0 0 12px rgba(255,145,0,0.4);" %>
      <% end %>

      <h1 style="font-size:22px;margin:16px 0 6px;color:#f9fafb;">
        Bekräfta ditt konto
      </h1>

      <p style="font-size:13px;color:#94a3b8;margin:0;">
        Tack för att du skapat ett konto! Klicka på knappen nedan för att bekräfta din e-postadress.
      </p>
    </div>

    <div style="text-align:center;margin:30px 0;">
      <%= link_to "Bekräfta min e-post",
                  confirmation_url(@resource, confirmation_token: @token),
                  data: { turbo: false },
                  style: "
                    display:inline-block;
                    padding:12px 22px;
                    border-radius:999px;
                    background:linear-gradient(to right,#fb923c,#ec4899);
                    color:#020617;
                    font-size:14px;
                    font-weight:600;
                    text-decoration:none;
                  " %>
    </div>

    <p style="font-size:12px;color:#94a3b8;margin:0;text-align:center;">
      Om du inte skapade ett konto kan du ignorera detta mail.
    </p>
  </div>
</div>
