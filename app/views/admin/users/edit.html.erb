<% content_for :title, "Admin – Redigera #{@user.name_or_email}" %>
<% content_for :meta_description, "Redigera användaren #{@user.name_or_email} i Barnaboll admin." %>

<div class="min-h-[calc(100vh-5rem)] bg-slate-950 text-slate-50">
  <div class="max-w-3xl mx-auto px-4 py-8 space-y-6">
    <header class="space-y-1">
      <p class="text-[11px] uppercase tracking-[0.2em] text-orange-300">
        Admin · Användare
      </p>
      <h1 class="text-2xl font-semibold tracking-tight">Redigera användare</h1>
      <p class="text-sm text-slate-400">
        Uppdatera kontouppgifter, admin-rättigheter eller lösenord.
      </p>
    </header>

    <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4">
      <%= render "form" %>
    </div>
  </div>
</div>
