<% if resource.errors.any? %>
  <div
    id="error_explanation"
    data-turbo-cache="false"
    class="mb-4 rounded-2xl border border-red-500/40 bg-red-950/70 px-4 py-3 text-sm text-red-100 shadow-lg shadow-red-900/40"
  >
    <div class="flex items-start gap-2">
      <div class="mt-1 h-2 w-2 rounded-full bg-red-400"></div>
      <div>
        <h2 class="mb-1 text-xs font-semibold tracking-[0.18em] uppercase text-red-300">
          <%= I18n.t("errors.messages.not_saved",
                     count: resource.errors.count,
                     resource: resource.class.model_name.human.downcase) %>
        </h2>
        <ul class="space-y-1 text-xs">
          <% resource.errors.full_messages.each do |message| %>
            <li>• <%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
<% end %>
