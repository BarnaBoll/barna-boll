<% content_for :title, "Logga in – Barnaboll" %>

<div class="min-h-[calc(100vh-5rem)] flex items-center justify-center bg-slate-950 text-slate-50">
  <div class="w-full max-w-md px-4">
    <!-- Header -->
    <header class="mb-6 text-center space-y-3">
      <div class="flex items-center justify-center gap-3">
        <%= link_to root_path do %>
          <%= image_tag "logo.svg",
                        alt: "Barnaboll",
                        class: "h-10 w-auto rounded-xl shadow-lg shadow-orange-500/30" %>
        <% end %>

        <div class="flex items-center gap-2 text-[11px] font-semibold tracking-[0.26em] uppercase">
          <span class="text-orange-300">Barnaboll</span>
          <span class="h-1 w-1 rounded-full bg-orange-400"></span>
          <span class="text-amber-200">Logga in</span>
        </div>
      </div>

      <h1 class="text-3xl font-semibold tracking-tight text-slate-50">
        Logga in på Barnaboll
      </h1>
      <p class="text-xs text-slate-400 max-w-sm mx-auto">
        Fortsätt där du slutade med dina sessions, inställningar och kommande funktioner.
      </p>
    </header>

    <!-- Card -->
    <div class="relative overflow-hidden rounded-[2rem] border border-slate-800 bg-slate-950/85 shadow-[0_0_80px_rgba(15,23,42,0.9)] px-5 py-6 sm:px-6 sm:py-7">
      <div class="pointer-events-none absolute -top-16 -right-10 h-32 w-32 rounded-full bg-orange-500/20 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-12 left-0 h-28 w-40 rounded-full bg-pink-500/15 blur-3xl"></div>

      <div class="relative">
        <%= form_for(resource,
                     as: resource_name,
                     url: session_path(resource_name),
                     html: { class: "space-y-4", data: { turbo: false } }) do |f| %>

          <!-- Email -->
          <div>
            <%= f.label :email, "E-post", class: "block text-xs font-semibold text-slate-300 mb-1" %>
            <%= f.email_field :email,
                              autofocus: true,
                              autocomplete: "email",
                              placeholder: "namn@example.com",
                              class: "w-full rounded-2xl border border-slate-700 bg-slate-950/60 px-4 py-2.5 text-sm text-slate-100 placeholder:text-slate-500 focus:border-orange-300 focus:outline-none focus:ring-0" %>
          </div>

          <!-- Password -->
          <div>
            <%= f.label :password, "Lösenord", class: "block text-xs font-semibold text-slate-300 mb-1" %>
            <div class="relative password-wrapper" data-password-wrapper>
              <%= f.password_field :password,
                                   autocomplete: "current-password",
                                   placeholder: "Ditt lösenord",
                                   class: "w-full rounded-2xl border border-slate-700 bg-slate-950/60 pr-10 px-4 py-2.5 text-sm text-slate-100 placeholder:text-slate-500 focus:border-orange-300 focus:outline-none focus:ring-0",
                                   data: { password_input: true } %>

              <button type="button"
                      class="absolute inset-y-0 right-3 flex items-center text-slate-500 hover:text-slate-200"
                      data-toggle-password>
                <span class="sr-only">Visa/dölj lösenord</span>
                <%= image_tag "icons/eye-off.svg",
                              alt: "",
                              class: "h-4 w-4",
                              data: { password_icon_visible: true } %>
                <%= image_tag "icons/eye.svg",
                              alt: "",
                              class: "h-4 w-4 hidden",
                              data: { password_icon_hidden: true } %>
              </button>
            </div>
          </div>

          <!-- Remember / Forgot -->
          <% if devise_mapping.rememberable? %>
            <div class="flex items-center justify-between text-[11px]">
              <label class="inline-flex items-center gap-2 text-slate-400">
                <%= f.check_box :remember_me,
                                class: "rounded border-slate-700 bg-slate-950 text-orange-400 focus:ring-0" %>
                <span>Kom ihåg den här enheten</span>
              </label>

              <% if devise_mapping.recoverable? %>
                <%= link_to "Glömt lösenord?",
                            new_password_path(resource_name),
                            class: "text-orange-300 hover:text-orange-200" %>
              <% end %>
            </div>
          <% end %>

          <!-- Submit -->
          <div class="pt-2">
            <%= f.submit "Logga in",
                         class: "w-full inline-flex items-center justify-center rounded-full px-5 py-2.5 text-sm font-semibold text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 shadow-lg shadow-orange-900/40 hover:from-orange-300 hover:to-pink-400 transition" %>
          </div>
        <% end %>

        <% if devise_mapping.registerable? %>
          <p class="mt-4 text-[11px] text-slate-400">
            Ny på Barnaboll?
            <%= link_to "Skapa ett konto",
                        new_registration_path(resource_name),
                        class: "text-orange-300 hover:text-orange-200 font-semibold" %>
          </p>
        <% end %>

        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>

<script>
  function setupBarnabollPasswordToggles() {
    document.querySelectorAll("[data-toggle-password]").forEach(function(button) {
      if (button.dataset.hasPasswordToggle === "true") return;
      button.dataset.hasPasswordToggle = "true";

      button.addEventListener("click", function () {
        // Grab the input that lives in the same wrapper as the button
        var wrapper = button.parentElement; // <div data-password-wrapper>...</div>
        if (!wrapper) return;

        var input = wrapper.querySelector("input[data-password-input]") || button.previousElementSibling;
        if (!input) return;

        var isPassword = input.type === "password";
        input.type = isPassword ? "text" : "password";

        var visibleIcon = button.querySelector("[data-password-icon-visible]");
        var hiddenIcon  = button.querySelector("[data-password-icon-hidden]");

        if (visibleIcon && hiddenIcon) {
          if (isPassword) {
            visibleIcon.classList.add("hidden");
            hiddenIcon.classList.remove("hidden");
          } else {
            visibleIcon.classList.remove("hidden");
            hiddenIcon.classList.add("hidden");
          }
        }
      });
    });
  }

  document.addEventListener("turbo:load", setupBarnabollPasswordToggles);
  document.addEventListener("DOMContentLoaded", setupBarnabollPasswordToggles);
</script>
