<!-- app/views/admin/promotional_emails/_form.html.erb -->
<%= form_with model: [:admin, @promotional_email], class: "space-y-6" do |f| %>

  <% if @promotional_email.errors.any? %>
    <div class="rounded-2xl border border-red-500/60 bg-red-500/10 p-3 text-xs text-red-100">
      <p class="font-semibold mb-1">Could not save:</p>
      <ul>
        <% @promotional_email.errors.full_messages.each do |msg| %>
          <li>• <%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid md:grid-cols-2 gap-4">
    <div>
      <label class="block text-[11px] uppercase tracking-[0.18em] text-slate-400 mb-1">Title</label>
      <%= f.text_field :title, class: "w-full rounded-xl border border-slate-700 bg-slate-900/70 px-3 py-2 text-sm text-slate-50" %>
    </div>

    <div>
      <label class="block text-[11px] uppercase tracking-[0.18em] text-slate-400 mb-1">Subject</label>
      <%= f.text_field :subject, class: "w-full rounded-xl border border-slate-700 bg-slate-900/70 px-3 py-2 text-sm text-slate-50" %>
    </div>
  </div>

  <div>
    <label class="block text-[11px] uppercase tracking-[0.18em] text-slate-400 mb-1">Intro</label>
    <%= f.text_area :intro, rows: 2, class: "w-full rounded-xl border border-slate-700 bg-slate-900/70 px-3 py-2 text-sm text-slate-50" %>
  </div>

  <div>
    <label class="block text-[11px] uppercase tracking-[0.18em] text-slate-400 mb-1">Body</label>
    <%= f.text_area :body, rows: 6, class: "w-full rounded-xl border border-slate-700 bg-slate-900/70 px-3 py-2 text-sm text-slate-50" %>
  </div>

  <div class="grid md:grid-cols-2 gap-4">
    <div>
      <label class="block text-[11px] uppercase tracking-[0.18em] text-slate-400 mb-1">CTA Label</label>
      <%= f.text_field :cta_label, class: "w-full rounded-xl border border-slate-700 bg-slate-900/70 px-3 py-2 text-sm text-slate-50" %>
    </div>

    <div>
      <label class="block text-[11px] uppercase tracking-[0.18em] text-slate-400 mb-1">CTA URL</label>
      <%= f.url_field :cta_url, class: "w-full rounded-xl border border-slate-700 bg-slate-900/70 px-3 py-2 text-sm text-slate-50" %>
    </div>
  </div>

  <div>
    <label class="block text-[11px] uppercase tracking-[0.18em] text-slate-400 mb-1">Send At (optional)</label>
    <%= f.datetime_local_field :send_at,
                               class: "w-full rounded-xl border border-slate-700 bg-slate-900/70 px-3 py-2 text-sm text-slate-50" %>
    <p class="mt-1 text-[11px] text-slate-500">
      Leave blank for a draft. Set a future date to schedule the blast.
    </p>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit(@promotional_email.new_record? ? "Create" : "Update",
                 class: "rounded-full px-5 py-2.5 text-xs font-semibold text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500") %>

    <% if @promotional_email.persisted? && @promotional_email.sent_at.blank? %>
      <%= button_to "Send Now",
                    send_now_admin_promotional_email_path(@promotional_email),
                    method: :post,
                    class: "rounded-full px-4 py-2 text-[11px] font-semibold border border-emerald-500 text-emerald-400 hover:bg-emerald-500/20" %>
    <% end %>

    <%= link_to "Cancel",
                admin_promotional_emails_path,
                class: "rounded-full px-4 py-2 text-[11px] font-semibold border border-slate-700 text-slate-300 hover:text-pink-300 hover:border-pink-400" %>
  </div>

<% end %>
