<% content_for :title, "Admin – Städer" %>

<div class="min-h-[calc(100vh-5rem)] bg-slate-950 text-slate-50">
  <div class="max-w-5xl mx-auto px-4 py-8 space-y-6">
    <header class="flex items-center justify-between">
      <div>
        <p class="text-[11px] uppercase tracking-[0.2em] text-orange-300 mb-1">
          Admin · Städer
        </p>
        <h1 class="text-2xl font-semibold tracking-tight">Städer</h1>
        <p class="text-sm text-slate-400">
          Hantera städer där Barnaboll kör sessions.
        </p>
      </div>

      <%= link_to "Ny stad",
                  new_admin_city_path,
                  class: "inline-flex items-center justify-center rounded-full px-5 py-2.5 text-xs sm:text-sm font-semibold text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 shadow-lg shadow-orange-900/40 hover:from-orange-300 hover:to-pink-400 transition" %>
    </header>

    <% if @cities.any? %>
      <div class="grid gap-4 md:grid-cols-2">
        <% @cities.each do |city| %>
          <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4 space-y-2">
            <div class="flex items-center justify-between">
              <div>
                <h2 class="text-sm font-semibold"><%= city.name %></h2>
                <% if city.description.present? %>
                  <p class="text-xs text-slate-400"><%= city.description %></p>
                <% end %>
              </div>
              <% if city.color.present? %>
                <span class="text-[11px] px-2 py-1 rounded-full border border-slate-700"
                      style="border-color: <%= city.color %>;">
                  <%= city.color %>
                </span>
              <% end %>
            </div>

            <p class="text-[11px] text-slate-500">
              Platser: <%= city.locations.count %> · Matcher: <%= city.matches.count %>
            </p>

            <div class="flex justify-end gap-2 pt-2">
              <%= link_to "Visa",
                          admin_city_path(city),
                          class: "text-[11px] rounded-full border border-slate-700 px-3 py-1 hover:border-pink-400 hover:text-pink-300" %>
              <%= link_to "Redigera",
                          edit_admin_city_path(city),
                          class: "text-[11px] rounded-full border border-slate-700 px-3 py-1 hover:border-pink-400 hover:text-pink-300" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-slate-400">Inga städer skapade ännu.</p>
    <% end %>
  </div>
</div>
