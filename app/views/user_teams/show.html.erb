<% content_for :title, "#{@user_team.name} – Lag" %>

<div class="min-h-[calc(100vh-5rem)] bg-slate-950 text-slate-50">
  <div class="max-w-4xl mx-auto px-4 py-8 space-y-6">

    <!-- Header -->
    <section class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <p class="inline-flex items-center gap-2 text-[11px] font-semibold tracking-[0.18em] uppercase text-orange-300 mb-1">
          <span class="h-1 w-1 rounded-full bg-orange-400"></span>
          Lag
        </p>

        <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight">
          <%= @user_team.name %>
        </h1>

        <% if @user_team.description.present? %>
          <p class="text-xs sm:text-sm text-slate-300 mt-1 max-w-xl">
            <%= @user_team.description %>
          </p>
        <% end %>

        <p class="text-[11px] text-slate-500 mt-2">
          Skapat av <span class="font-mono text-slate-200"><%= @user_team.creator.name_or_email %></span>
          · <%= @user_team.members.count %> spelare
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2 justify-end">
        <% if @user_team.creator?(current_user) %>
          <span class="rounded-full border border-emerald-500/60 bg-emerald-500/10 px-2.5 py-0.5 text-[10px] font-semibold text-emerald-300">
            Du är skapare
          </span>
        <% end %>

        <%= link_to "Tillbaka till dashboard",
                    authenticated_root_path,
                    class: "inline-flex items-center justify-center rounded-full px-3 py-1.5 text-[11px] font-semibold border border-slate-600/70 text-slate-200 hover:border-pink-400 hover:bg-slate-900/60 transition" %>
      </div>
    </section>

    <section class="grid gap-5 lg:grid-cols-[1.2fr_1.1fr]">
      <!-- Members & creator tools -->
      <div class="space-y-4">
        <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4 text-sm">
          <div class="flex items-center justify-between mb-3">
            <div>
              <h2 class="text-base font-semibold">Medlemmar</h2>
              <p class="text-xs text-slate-400">
                Alla spelare i laget.
              </p>
            </div>
          </div>

          <% if @user_team.members.blank? %>
            <p class="text-xs text-slate-400">
              Inga medlemmar ännu.
            </p>
          <% else %>
            <ul class="space-y-2 text-sm">
              <% @user_team.members.each do |member| %>
                <li class="flex items-center justify-between gap-2 rounded-xl border border-slate-800 bg-slate-900/70 px-3 py-2">
                  <div>
                    <p class="font-semibold text-slate-50">
                      <%= member.name.presence || member.email %>
                    </p>
                    <p class="text-[11px] text-slate-400">
                      <%= member.email %>
                      <% if member.id == @user_team.creator_id %>
                        · <span class="text-emerald-300 font-semibold">skapare</span>
                      <% end %>
                    </p>
                  </div>

                  <% if @user_team.creator?(current_user) && member.id != @user_team.creator_id %>
                    <%= button_to "Ta bort",
                                  remove_member_user_team_path(@user_team, member),
                                  method: :delete,
                                  form: { data: { turbo_confirm: "Ta bort den här spelaren från laget?" } },
                                  class: "text-[11px] text-rose-300 hover:text-rose-200" %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>

        <% if @user_team.creator?(current_user) %>
          <!-- Creator: invite member by email + edit name/description -->
          <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4 text-sm space-y-4">
            <div>
              <h2 class="text-base font-semibold mb-1">Hantera lag</h2>
              <p class="text-xs text-slate-400">
                Endast du som skapare kan lägga till medlemmar och ändra laginfo.
              </p>
            </div>

            <!-- Add member -->
            <div class="border border-slate-800 rounded-xl p-3 space-y-2">
              <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-400">
                Lägg till medlem
              </p>

              <%= form_with url: add_member_user_team_path(@user_team),
                            method: :post,
                            local: true do |f| %>
                <div class="flex flex-col sm:flex-row gap-2">
                  <input type="email"
                         name="email"
                         placeholder="Spelarens e-post"
                         required
                         class="flex-1 rounded-xl border border-slate-700 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 focus:outline-none focus:ring-2 focus:ring-orange-400/70" />
                  <button type="submit"
                          class="inline-flex items-center justify-center rounded-full px-4 py-2 text-[11px] font-semibold text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 hover:from-orange-300 hover:to-pink-400 transition">
                    Lägg till
                  </button>
                </div>
                <p class="text-[10px] text-slate-500 mt-1">
                  Spelaren måste redan ha ett konto med den här e-posten.
                </p>
              <% end %>
            </div>

            <!-- Edit team info -->
            <div class="border border-slate-800 rounded-xl p-3 space-y-2">
              <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-400">
                Redigera laginfo
              </p>

              <%= form_with model: @user_team, url: user_team_path(@user_team), method: :patch, local: true do |f| %>
                <div class="space-y-3">
                  <div>
                    <label class="block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-400 mb-1">
                      Lagnamn
                    </label>
                    <%= f.text_field :name,
                                     class: "w-full rounded-xl border border-slate-700 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 focus:outline-none focus:ring-2 focus:ring-orange-400/70" %>
                  </div>
                  <div>
                    <label class="block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-400 mb-1">
                      Beskrivning
                    </label>
                    <%= f.text_area :description,
                                    rows: 3,
                                    class: "w-full rounded-xl border border-slate-700 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 focus:outline-none focus:ring-2 focus:ring-orange-400/70" %>
                  </div>
                </div>

                <div class="mt-3 flex items-center justify-between">
                  <%= button_to "Radera lag",
                                user_team_path(@user_team),
                                method: :delete,
                                form: { data: { turbo_confirm: "Är du säker på att du vill ta bort laget? Detta går inte att ångra." } },
                                class: "text-[11px] text-rose-300 hover:text-rose-200" %>

                  <%= f.submit "Spara ändringar",
                               class: "inline-flex items-center justify-center rounded-full px-4 py-2 text-[11px] font-semibold text-slate-950 bg-slate-50 hover:bg-slate-200 transition" %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Upcoming matches + simple stats -->
      <aside class="space-y-4">
        <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4 text-sm">
          <div class="flex items-center justify-between mb-3">
            <div>
              <h2 class="text-base font-semibold">Kommande matcher</h2>
              <p class="text-xs text-slate-400">
                Matcher där någon i laget är registrerad.
              </p>
            </div>
            <%= link_to "Matchkalender",
                        schedule_path,
                        class: "text-[11px] text-slate-400 hover:text-orange-300" %>
          </div>

          <% if @upcoming_matches.blank? %>
            <p class="text-xs text-slate-400">
              Inga kommande matcher hittades för laget.
            </p>
          <% else %>
            <div class="space-y-3">
              <% @upcoming_matches.each do |match| %>
                <div class="rounded-xl border border-slate-800 bg-slate-900/80 px-3 py-2.5 space-y-1.5">
                  <div class="flex items-center justify-between gap-2">
                    <p class="text-sm font-semibold text-slate-50">
                      <%= match.title %>
                    </p>
                    <% if match.time.present? %>
                      <span class="font-mono text-[11px] text-slate-300">
                        <%= match.time.strftime("%H:%M") %>
                      </span>
                    <% end %>
                  </div>

                  <p class="text-[11px] text-slate-400">
                    <%= l(match.date, format: :short) rescue match.date.to_s %>
                    · <%= match.city.name %>
                    <% if match.location.present? %> · <%= match.location.name %><% end %>
                  </p>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <% if @player_stats_by_user.present? %>
          <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4 text-sm">
            <h2 class="text-base font-semibold mb-2">Lagets stats</h2>
            <p class="text-xs text-slate-400 mb-3">
              Summering per spelare (från alla städer/platser).
            </p>

            <div class="space-y-2">
              <% @player_stats_by_user.each do |user, stats| %>
                <% total_played = stats.sum(&:matches_played) %>
                <% total_wins   = stats.sum(&:wins) %>
                <% total_losses = stats.sum(&:losses) %>

                <div class="rounded-xl border border-slate-800 bg-slate-900/80 px-3 py-2">
                  <p class="text-sm font-semibold text-slate-50">
                    <%= user.name.presence || user.email %>
                  </p>
                  <p class="text-[11px] text-slate-400">
                    Matcher: <%= total_played %> · Vinster: <%= total_wins %> · Förluster: <%= total_losses %>
                  </p>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </aside>
    </section>
  </div>
</div>
