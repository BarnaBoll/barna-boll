<% content_for :title, "Admin – Platser i #{@city.name}" %>
<% content_for :meta_description, "Lista och hantering av platser i #{@city.name}." %>

<div class="min-h-[calc(100vh-5rem)] bg-slate-950 text-slate-50">
  <div class="max-w-5xl mx-auto px-4 py-8 space-y-6">
    <header class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <p class="text-[11px] uppercase tracking-[0.2em] text-orange-300 mb-1">
          Admin · Platser
        </p>
        <h1 class="text-2xl font-semibold tracking-tight">
          Platser i <%= @city.name %>
        </h1>
        <p class="text-sm text-slate-400">
          Hantera planer och hallar där ni spelar i den här staden.
        </p>
      </div>

      <div class="flex flex-wrap gap-2 justify-start md:justify-end">
        <%= link_to "Tillbaka till stad",
                    admin_city_path(@city),
                    class: "inline-flex items-center justify-center rounded-full px-4 py-2.5 text-[11px] sm:text-xs font-semibold border border-slate-700 text-slate-200 hover:border-orange-400" %>

        <%= link_to "Ny plats",
                    new_admin_city_location_path(@city),
                    class: "inline-flex items-center justify-center rounded-full px-4 py-2.5 text-[11px] sm:text-xs font-semibold text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 shadow-lg shadow-orange-900/40 hover:from-orange-300 hover:to-pink-400 transition" %>
      </div>
    </header>

    <% if @locations.any? %>
      <div class="grid gap-4 md:grid-cols-2">
        <% @locations.each do |location| %>
          <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4 space-y-1">
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-sm font-semibold text-slate-100"><%= location.name %></h2>
              <%= link_to "Visa",
                          admin_city_location_path(@city, location),
                          class: "text-[11px] rounded-full border border-slate-700 px-3 py-1 hover:border-orange-400" %>
            </div>

            <% if location.address.present? %>
              <p class="text-xs text-slate-300"><%= location.address %></p>
            <% end %>

            <% if location.description.present? %>
              <p class="text-[11px] text-slate-500"><%= location.description %></p>
            <% end %>

            <p class="text-[11px] text-slate-500 mt-1">
              Matcher: <%= location.matches.count %>
            </p>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-slate-400">
        Inga platser skapade i den här staden ännu.
      </p>
    <% end %>
  </div>
</div>
