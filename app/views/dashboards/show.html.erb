<% content_for :title, "Dashboard – #{current_user.name || current_user.email}" %>

<div class="min-h-[calc(100vh-5rem)] bg-slate-950 text-slate-50">
  <div class="max-w-5xl mx-auto px-4 py-8 space-y-6">

    <!-- Header -->
    <section class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <p class="inline-flex items-center gap-2 text-[11px] font-semibold tracking-[0.18em] uppercase text-orange-300 mb-1">
          <span class="h-1 w-1 rounded-full bg-orange-400"></span>
          Dashboard
        </p>

        <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight">
          Hej, <%= @user.name.presence || @user.email %>
        </h1>

        <p class="text-xs sm:text-sm text-slate-400 mt-1">
          Här ser du kommande matcher att boka, dina anmälningar och dina lag.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <%= link_to "Profil",
                    profile_path,
                    class: "inline-flex items-center justify-center rounded-full px-4 py-1.5 text-[11px] font-semibold border border-slate-600/70 text-slate-200 hover:border-pink-400 hover:bg-slate-900/60 transition" %>

        <%= button_to "Logga ut",
                      destroy_user_session_path,
                      method: :delete,
                      class: "inline-flex items-center justify-center rounded-full px-4 py-1.5 text-[11px] font-semibold border border-slate-600/70 text-slate-200 hover:border-orange-400 hover:bg-slate-900/60 transition" %>
      </div>
    </section>

    <!-- Layout: Left = upcoming to register, Right = registered -->
    <section class="grid gap-5 lg:grid-cols-[1.5fr_1.1fr]">

      <!-- Left: Upcoming matches to register for -->
      <div class="flex flex-col">
        <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4 text-sm space-y-4 h-full flex flex-col">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 class="text-base font-semibold">Boka nästa match</h2>
              <p class="text-xs text-slate-400">
                Se de närmaste kommande matcherna och boka direkt här.
              </p>
            </div>

            <!-- City filter (same style as schedule page, men enklare) -->
            <div class="w-full sm:w-auto flex justify-end">
              <%= form_with url: authenticated_root_path,
                            method: :get,
                            local: true,
                            class: "text-xs" do %>
                <div class="inline-flex items-center gap-2 rounded-full border border-slate-700 bg-slate-900/80 pl-3 pr-1 py-1.5"
                     data-city-select-wrapper>
                  <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500">
                    Stad
                  </span>

                  <% current_city_label = @selected_city&.name || "Alla städer" %>
                  <% current_city_color = @selected_city_color.presence || "#e5e7eb" %>

                  <%= hidden_field_tag :city, params[:city].to_s, id: "dashboard-city-input" %>

                  <button type="button"
                          data-city-select-button
                          class="inline-flex items-center gap-2 rounded-full bg-transparent px-2 py-0.5 text-[11px] text-slate-100 focus:outline-none focus:ring-0">
                    <span class="h-1.5 w-1.5 rounded-full"
                          data-city-dot
                          style="background-color: <%= current_city_color %>;"></span>
                    <span data-city-label><%= current_city_label %></span>
                  </button>

                  <span class="ml-1 text-[10px] text-slate-400">▾</span>

                  <div data-city-select-menu
                       class="absolute z-30 mt-32 right-4 md:right-auto md:translate-x-0 w-48 rounded-2xl border border-slate-700 bg-slate-900/95 shadow-xl py-1 hidden">
                    <!-- "Alla städer" -->
                    <button type="button"
                            class="w-full flex items-center gap-2 px-3 py-1.5 text-[11px] text-slate-100 text-left hover:bg-slate-800/80"
                            data-city-option
                            data-value=""
                            data-label="Alla städer"
                            data-color="#e5e7eb">
                      <span class="h-1.5 w-1.5 rounded-full"
                            style="background-color: #e5e7eb;"></span>
                      <span>Alla städer</span>
                    </button>

                    <% @cities.each do |city| %>
                      <% value = city.to_param %>
                      <% color =
                           if city.respond_to?(:accent_color) && city.accent_color.present?
                             city.accent_color
                           elsif city.respond_to?(:color_hex) && city.color_hex.present?
                             city.color_hex
                           elsif city.respond_to?(:primary_color) && city.primary_color.present?
                             city.primary_color
                           elsif city.respond_to?(:color) && city.color.present?
                             city.color
                           else
                             "#f97316"
                           end %>
                      <button type="button"
                              class="w-full flex items-center gap-2 px-3 py-1.5 text-[11px] text-slate-100 text-left hover:bg-slate-800/80"
                              data-city-option
                              data-value="<%= value %>"
                              data-label="<%= city.name %>"
                              data-color="<%= color %>">
                        <span class="h-1.5 w-1.5 rounded-full"
                              style="background-color: <%= color %>;"></span>
                        <span><%= city.name %></span>
                      </button>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>

          <% if @discover_matches.blank? %>
            <p class="text-xs text-slate-400 flex-1">
              Inga kommande matcher hittades för detta filter. Testa en annan stad eller kolla hela
              <%= link_to "matchkalendern", schedule_path, class: "underline decoration-dotted hover:text-orange-300" %>.
            </p>
          <% else %>
            <div class="space-y-3 flex-1">
              <% @discover_matches.each do |match| %>
                <% booked   = match.total_players %>
                <% capacity = match.hard_limit_total || 0 %>
                <% ratio    = capacity.positive? ? (booked.to_f / capacity.to_f) : 0.0 %>
                <% full     = capacity.positive? && booked >= capacity %>

                <% already_registered =
                     match.registrations.where(user_id: current_user.id).exists? ||
                       match.registrations.where(user_team_id: current_user.user_teams.select(:id)).exists? %>

                <% disabled = full || already_registered %>
                <% city_dot_color = match.city&.color.presence || "#f97316" %>

                <div class="rounded-xl border border-slate-800 bg-slate-900/80 px-3 py-2.5 space-y-1.5">
                  <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                    <div class="space-y-1">
                      <div class="flex flex-wrap items-center gap-2">
                        <p class="text-sm font-semibold text-slate-50">
                          <%= match.title %>
                        </p>
                        <span class="inline-flex items-center gap-1 rounded-full border border-slate-700 px-2 py-0.5 text-[11px] text-slate-300">
                          <span class="h-1.5 w-1.5 rounded-full"
                                style="background-color: <%= city_dot_color %>;"></span>
                          <%= match.city.name %>
                        </span>
                        <% if match.location.present? %>
                          <span class="inline-flex items-center gap-1 rounded-full border border-slate-700 px-2 py-0.5 text-[11px] text-slate-300">
                            <%= match.location.name %>
                          </span>
                        <% end %>
                      </div>

                      <p class="text-[11px] text-slate-400">
                        <%= l(match.date, format: :short) rescue match.date.to_s %>
                        <% if match.time %>
                          · <span class="font-mono text-slate-200"><%= match.time.strftime("%H:%M") %></span>
                        <% end %>
                        <% if match.price.present? %>
                          · <%= match.price.to_i %> kr
                        <% end %>
                      </p>
                    </div>

                    <div class="mt-2 sm:mt-0 flex flex-col items-stretch gap-2 sm:items-end sm:text-right">
                      <div class="w-full sm:w-40">
                        <div class="flex items-center justify-between text-[11px] text-slate-400 mb-0.5">
                          <span>Platser</span>
                          <span class="font-mono text-slate-200">
                            <%= booked %> / <%= capacity %>
                          </span>
                        </div>
                        <% status_color =
                             if capacity.zero?
                               "bg-slate-500"
                             elsif ratio >= 1.0
                               "bg-rose-400"
                             elsif ratio >= 0.7
                               "bg-amber-300"
                             else
                               "bg-emerald-400"
                             end %>
                        <div class="h-1.5 w-full rounded-full bg-slate-800 overflow-hidden">
                          <div class="h-full <%= status_color %>"
                               style="width: <%= [[(ratio * 100).round, 0].max, 100].min %>%;">
                          </div>
                        </div>
                      </div>

                      <button
                        type="button"
                        class="mt-1 inline-flex items-center justify-center rounded-full px-3 py-1.5 text-[11px] font-semibold <%= disabled ? 'text-slate-300 bg-slate-800 cursor-not-allowed' : 'text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 hover:from-orange-300 hover:to-pink-400' %>"
                        <% unless disabled %>
                          data-open-register-modal
                          data-match-id="<%= match.id %>"
                          data-match-title="<%= match.title %>"
                          data-match-city="<%= match.city.name %>"
                          data-match-datetime="<%= [
                            (l(match.date, format: :short) rescue match.date.to_s),
                            (match.time&.strftime('%H:%M'))
                          ].compact.join(' · ') %>"
                          data-user-signed-in="true"
                        <% end %>>
                        <% if full %>
                          Fullbokat
                        <% elsif already_registered %>
                          Redan anmäld
                        <% else %>
                          Boka plats
                        <% end %>
                      </button>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>

            <p class="text-[11px] text-slate-500 mt-1">
              Vill du se alla matcher? Gå till
              <%= link_to "matchkalendern", schedule_path, class: "underline decoration-dotted hover:text-orange-300" %>.
            </p>
          <% end %>
        </div>
      </div>

      <!-- Right: Registered matches (same height as left) -->
      <div class="flex flex-col">
        <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4 text-sm h-full flex flex-col">
          <div class="flex items-center justify-between mb-3">
            <div>
              <h2 class="text-base font-semibold">Dina bokade matcher</h2>
              <p class="text-xs text-slate-400">
                Matcher där du eller någon i dina lag är registrerade.
              </p>
            </div>
            <%= link_to "Matchkalender",
                        schedule_path,
                        class: "text-[11px] text-slate-400 hover:text-orange-300" %>
          </div>

          <% if @registered_matches.blank? %>
            <p class="text-xs text-slate-400 flex-1">
              Du har inga kommande matcher. Boka en via listan till vänster eller kalendern.
            </p>
          <% else %>
            <div class="space-y-3 flex-1">
              <% @registered_matches.each do |match| %>
                <% booked   = match.total_players %>
                <% capacity = match.hard_limit_total || 0 %>
                <% ratio    = capacity.positive? ? (booked.to_f / capacity.to_f) : 0.0 %>

                <% status_color =
                     if capacity.zero?
                       "bg-slate-500"
                     elsif ratio >= 1.0
                       "bg-rose-400"
                     elsif ratio >= 0.7
                       "bg-amber-300"
                     else
                       "bg-emerald-400"
                     end %>

                <div class="rounded-xl border border-slate-800 bg-slate-900/80 px-3 py-2.5 space-y-1.5">
                  <div class="flex items-center justify-between gap-2">
                    <p class="text-sm font-semibold text-slate-50">
                      <%= match.title %>
                    </p>
                    <% if match.time.present? %>
                      <span class="font-mono text-[11px] text-slate-300">
                        <%= match.time.strftime("%H:%M") %>
                      </span>
                    <% end %>
                  </div>

                  <p class="text-[11px] text-slate-400">
                    <%= l(match.date, format: :short) rescue match.date.to_s %>
                    · <%= match.city.name %>
                    <% if match.location.present? %> · <%= match.location.name %><% end %>
                  </p>

                  <div class="mt-1">
                    <div class="flex items-center justify-between text-[11px] text-slate-400 mb-0.5">
                      <span>Platser</span>
                      <span class="font-mono text-slate-200">
                        <%= booked %> / <%= capacity %>
                      </span>
                    </div>
                    <div class="h-1.5 w-full rounded-full bg-slate-800 overflow-hidden">
                      <div class="h-full <%= status_color %>"
                           style="width: <%= [[(ratio * 100).round, 0].max, 100].min %>%;">
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

    </section>

    <!-- Full-width: Dina lag -->
    <section>
      <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4 text-sm">
        <div class="flex items-center justify-between mb-3">
          <div>
            <h2 class="text-base font-semibold">Dina lag</h2>
            <p class="text-xs text-slate-400">
              Lag du är med i, som spelare eller skapare.
            </p>
          </div>

          <%= link_to "Hantera lag",
                      user_teams_path,
                      class: "text-[11px] text-slate-400 hover:text-orange-300" %>
        </div>

        <% if @user_teams.blank? %>
          <p class="text-xs text-slate-400">
            Du är inte med i något lag än.
            <%= link_to "Skapa eller gå med i lag här.",
                        user_teams_path,
                        class: "underline decoration-dotted hover:text-orange-300" %>
          </p>
        <% else %>
          <div class="space-y-3">
            <% @user_teams.each do |team| %>
              <div class="rounded-xl border border-slate-800 bg-slate-900/70 px-3 py-2.5 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                <div class="space-y-1">
                  <div class="flex items-center gap-2 flex-wrap">
                    <p class="text-sm font-semibold text-slate-50">
                      <%= team.name %>
                    </p>
                    <% if team.creator?(current_user) %>
                      <span class="rounded-full border border-emerald-500/60 bg-emerald-500/10 px-2 py-0.5 text-[10px] font-semibold text-emerald-300">
                        Du är skapare
                      </span>
                    <% end %>
                  </div>

                  <% if team.description.present? %>
                    <p class="text-[11px] text-slate-400">
                      <%= truncate(team.description, length: 120) %>
                    </p>
                  <% end %>

                  <p class="text-[11px] text-slate-500">
                    <span class="font-semibold"><%= team.members.count %></span> spelare ·
                    Skapad av <span class="font-mono text-slate-300"><%= team.creator.name_or_email %></span>
                  </p>
                </div>

                <div class="mt-2 sm:mt-0 flex items-center gap-2 justify-end">
                  <%= link_to "Visa lag",
                              user_team_path(team),
                              class: "inline-flex items-center justify-center rounded-full px-3 py-1.5 text-[11px] font-semibold text-slate-950 bg-slate-50 hover:bg-slate-200 transition" %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>

  </div>
</div>

<style>
  @keyframes fadeInSlow {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @keyframes fadeOutSlow {
    from { opacity: 1; }
    to   { opacity: 0; }
  }

  @keyframes modalZoomIn {
    0%   { transform: scale(0.92); opacity: 0; }
    100% { transform: scale(1);    opacity: 1; }
  }
</style>

<!-- Register modals (same behavior as schedule page) -->
<div id="register-modal"
     class="fixed inset-0 w-screen h-screen z-50 hidden opacity-0 pointer-events-none transition-opacity duration-300 js-calendar-modal">
  <div class="fixed inset-0 w-screen h-screen bg-gradient-to-br from-black/80 via-slate-950/70 to-black/80 backdrop-blur-md transition-opacity duration-300"
       data-modal-dismiss></div>

  <div class="absolute inset-0 flex items-center justify-center px-4">
    <div id="register-modal-content"
         class="w-full max-w-md rounded-2xl border border-slate-700/70 bg-slate-950 p-5 shadow-xl scale-95 opacity-0 transition-all duration-300">
      <div class="flex items-center justify-between mb-3">
        <div>
          <p class="text-[11px] uppercase tracking-[0.18em] text-orange-300 mb-1">
            Anmälan
          </p>
          <h3 class="text-sm font-semibold text-slate-100" id="register-modal-title">
            Registrera dig till match
          </h3>
          <p class="text-[11px] text-slate-400 mt-0.5" id="register-modal-meta"></p>
        </div>

        <button type="button"
                class="text-slate-400 hover:text-slate-200 text-sm"
                data-modal-dismiss>
          ✕
        </button>
      </div>

      <p class="text-xs text-slate-400 mb-4">
        Välj om du vill anmäla dig som individuell spelare eller med ett lag.
      </p>

      <%= form_with url: registrations_path,
                    method: :post,
                    local: true,
                    html: { id: "register-match-form" } do |f| %>
        <%= hidden_field_tag :match_id, nil, id: "register-match-id" %>

        <div class="space-y-3 text-sm">
          <div>
            <label class="block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-400 mb-1">
              Typ av anmälan
            </label>
            <div class="grid grid-cols-2 gap-2 text-[11px]">
              <button type="button"
                      class="js-register-type-btn rounded-xl border border-slate-700 bg-slate-900/70 px-3 py-2 text-left text-slate-200 hover:border-orange-400 data-[active=true]:border-orange-400 data-[active=true]:bg-slate-900"
                      data-type="individual"
                      data-active="true">
                Individuell
                <p class="text-[10px] text-slate-400">
                  Du kommer själv, vi placerar dig i lag.
                </p>
              </button>
              <button type="button"
                      class="js-register-type-btn rounded-xl border border-slate-700 bg-slate-900/70 px-3 py-2 text-left text-slate-200 hover:border-orange-400 data-[active=true]:border-orange-400 data-[active=true]:bg-slate-900"
                      data-type="team"
                      data-active="false">
                Lag
                <p class="text-[10px] text-slate-400">
                  Du anmäler ett gäng (2–5 spelare).
                </p>
              </button>
            </div>
            <%= hidden_field_tag :registration_type, "individual", id: "register-type-input" %>
          </div>

          <div id="user-team-wrapper" class="hidden mt-1">
            <label class="block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-400 mb-1">
              Välj lag
            </label>
            <% if @user_teams.present? %>
              <select name="user_team_id"
                      id="user-team-select"
                      class="w-full rounded-xl border border-slate-700 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 focus:outline-none focus:ring-2 focus:ring-orange-400/70"
                      data-user-team-select>
                <% @user_teams.each do |ut| %>
                  <option value="<%= ut.id %>"
                          data-member-count="<%= ut.members.count %>"
                          data-members="<%= ut.members.map { |m| { id: m.id, name: m.name_or_email } }.to_json %>">
                    <%= ut.name %> (<%= ut.members.count %> medlemmar)
                    <% if ut.creator?(current_user) %>
                      (skapare)
                    <% end %>
                  </option>
                <% end %>
              </select>
              <p class="text-[10px] text-slate-500 mt-1">
                Dina lag hämtas från den här vyn. Hantera lag via ”Dina lag”.
              </p>
            <% else %>
              <p class="text-[11px] text-slate-400">
                Du har inga lag ännu. Skapa ett lag under ”Dina lag” för att kunna anmäla ett lag.
              </p>
            <% end %>
          </div>

          <div id="team-size-wrapper" class="hidden">
            <label class="block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-400 mb-1">
              Antal spelare som kommer
            </label>
            <%= number_field_tag :team_size,
                                nil,
                                min: 1,
                                max: 10,
                                readonly: true,
                                class: "w-full rounded-xl border border-slate-700 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 focus:outline-none focus:ring-2 focus:ring-orange-400/70 cursor-default",
                                id: "team-size-input" %>
            <p class="text-[10px] text-slate-500 mt-1" id="team-size-help"></p>
          </div>

          <!-- NEW: Team members list so you can mark who cannot make it -->
          <div id="team-members-wrapper" class="hidden mt-2">
            <label class="block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-400 mb-1">
              Spelare i laget
            </label>
            <p class="text-[10px] text-slate-500 mb-1">
              Markera vilka spelare som <span class="font-semibold text-slate-300">kommer</span>. Avmarkera de som inte kan komma. Antalet kryssade spelare styr automatiskt antalet platser.
            </p>
            <div id="team-members-list" class="space-y-1 text-[11px] text-slate-100">
              <!-- Fylls i via JavaScript baserat på valt lag -->
            </div>
          </div>

          <div>
            <label class="block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-400 mb-1">
              Kommentar (valfritt)
            </label>
            <%= text_area_tag :note,
                              nil,
                              rows: 3,
                              class: "w-full rounded-xl border border-slate-700 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 focus:outline-none focus:ring-2 focus:ring-orange-400/70",
                              placeholder: "T.ex. vilka i laget som inte kan, nivå, önskemål…" %>
          </div>
        </div>

        <div class="mt-4 flex justify-end gap-3">
          <button type="button"
                  class="text-[11px] text-slate-400 hover:text-slate-200"
                  data-modal-dismiss>
            Avbryt
          </button>

          <%= f.submit "Skicka anmälan",
                       class: "inline-flex items-center justify-center rounded-full px-4 py-2 text-[11px] font-semibold text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 shadow-lg hover:from-orange-300 hover:to-pink-400 transition" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Guest modal (just in case, should rarely show on dashboard because user is authenticated) -->
<div id="auth-required-modal"
     class="fixed inset-0 w-screen h-screen z-50 hidden opacity-0 pointer-events-none transition-opacity duration-300 js-calendar-modal">
  <div class="fixed inset-0 w-screen h-screen bg-gradient-to-br from-black/85 via-slate-950/70 to-black/85 backdrop-blur-md transition-opacity duration-300"
       data-modal-dismiss></div>

  <div class="absolute inset-0 flex items-center justify-center px-4">
    <div id="auth-required-modal-content"
         class="w-full max-w-md rounded-2xl border border-slate-700/70 bg-slate-950 p-5 shadow-xl scale-95 opacity-0 transition-all duration-300">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-semibold text-slate-100">
          Skapa konto för att boka
        </h3>
        <button type="button"
                class="text-slate-400 hover:text-slate-200 text-sm"
                data-modal-dismiss>
          ✕
        </button>
      </div>

      <p class="text-xs text-slate-300 mb-3">
        Du behöver ett Barnaboll-konto för att anmäla dig till matcher.
      </p>
      <p class="text-xs text-slate-400 mb-4">
        Med konto kan du se dina kommande matcher, bygga stats och få uppdateringar om nya sessions.
      </p>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mt-2">
        <%= link_to "Logga in",
                    new_user_session_path,
                    class: "inline-flex items-center justify-center rounded-full px-4 py-2 text-[11px] sm:text-xs font-semibold text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 shadow-lg hover:from-orange-300 hover:to-pink-400 transition" %>

        <%= link_to "Skapa konto",
                    new_user_registration_path,
                    class: "inline-flex items-center justify-center rounded-full px-4 py-2 text-[11px] sm:text-xs font-semibold text-slate-200 border border-slate-700 hover:border-pink-400 hover:bg-slate-900/60 transition" %>
      </div>

      <p class="mt-3 text-[10px] text-slate-500">
        Du kan fortfarande se alla matcher i kalendern utan konto.
      </p>
    </div>
  </div>
</div>

<script>
function openCalendarModal(modal, content) {
  if (!modal || !content) return;
  modal.classList.remove("hidden", "pointer-events-none");
  modal.style.opacity = "1";
  modal.style.animation = "fadeInSlow 0.25s ease-out";
  content.style.animation = "modalZoomIn 0.25s ease-out forwards";
}

function closeCalendarModal(modal) {
  if (!modal) return;
  modal.style.animation = "fadeOutSlow 0.25s ease-in";
  modal.style.opacity = "0";
  modal.classList.add("pointer-events-none");
  setTimeout(function () {
    modal.classList.add("hidden");
  }, 260);
}

function resetCalendarModals() {
  document.querySelectorAll(".js-calendar-modal").forEach(function (modal) {
    modal.classList.add("hidden", "pointer-events-none");
    modal.style.opacity = "0";
    modal.style.animation = "none";
  });
}

function initTeamRegistration() {
  const teamSelect         = document.getElementById('user-team-select');
  const teamSizeInput      = document.getElementById('team-size-input');
  const teamSizeHelp       = document.getElementById('team-size-help');
  const typeInput          = document.getElementById('register-type-input');
  const teamMembersWrapper = document.getElementById('team-members-wrapper');
  const teamMembersList    = document.getElementById('team-members-list');

  if (!teamSelect || !teamSizeInput || !teamSizeHelp || !teamMembersList) return;

  // extra safety: make sure number field can't be changed manually
  teamSizeInput.readOnly = true;
  teamSizeInput.addEventListener('wheel', function (e) { e.preventDefault(); });
  teamSizeInput.addEventListener('keydown', function (e) { e.preventDefault(); });

  function syncTeamSizeFromCheckboxes() {
    if (!teamMembersList || !teamSizeInput) return;
    const checkedCount = teamMembersList.querySelectorAll('input[name="present_member_ids[]"]:checked').length;
    if (checkedCount > 0) {
      teamSizeInput.value = checkedCount;
    }
  }

  function buildMembersListFromSelection() {
    const selectedOption = teamSelect.options[teamSelect.selectedIndex];
    if (!selectedOption) return;

    const membersJson = selectedOption.dataset.members;
    let members = [];

    if (membersJson) {
      try {
        members = JSON.parse(membersJson);
      } catch (e) {
        members = [];
      }
    }

    teamMembersList.innerHTML = '';

    if (!members.length) {
      if (teamMembersWrapper) teamMembersWrapper.classList.add('hidden');
      teamSizeHelp.textContent = '';
      return;
    }

    members.forEach(function(member) {
      const row = document.createElement('label');
      row.className = "flex items-center gap-2 text-[11px] text-slate-100";

      const checkbox = document.createElement('input');
      checkbox.type = 'checkbox';
      checkbox.name = 'present_member_ids[]';
      checkbox.value = member.id;
      checkbox.checked = true;
      checkbox.className = "h-3 w-3 rounded border-slate-500 bg-slate-900";

      const nameSpan = document.createElement('span');
      nameSpan.textContent = member.name || ("Spelare " + member.id);

      row.appendChild(checkbox);
      row.appendChild(nameSpan);
      teamMembersList.appendChild(row);
    });

    if (teamMembersWrapper) {
      teamMembersWrapper.classList.remove('hidden');
    }

    const memberCount = members.length;
    teamSizeInput.value = memberCount;
    teamSizeInput.max   = memberCount;
    teamSizeHelp.textContent = `Antal medlemmar i laget: ${memberCount}. Avmarkera de som inte kan komma – vi uppdaterar antalet platser automatiskt.`;

    // Listen for changes on checkboxes to keep team_size in sync
    teamMembersList.addEventListener('change', syncTeamSizeFromCheckboxes);
    syncTeamSizeFromCheckboxes();
  }

  function updateTeamSizeFromSelection() {
    const selectedOption = teamSelect.options[teamSelect.selectedIndex];
    if (!selectedOption) return;

    const memberCountData = selectedOption.dataset.memberCount;
    if (memberCountData) {
      const memberCount = parseInt(memberCountData, 10);
      if (!isNaN(memberCount)) {
        teamSizeInput.value = memberCount;
        teamSizeInput.max   = memberCount;
        teamSizeHelp.textContent = `Antal medlemmar i laget: ${memberCount}. Avmarkera de som inte kan komma.`;
      }
    }

    // Build member list as well
    buildMembersListFromSelection();
  }

  teamSelect.addEventListener('change', function() {
    updateTeamSizeFromSelection();
  });

  document.querySelectorAll('.js-register-type-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (this.dataset.type === 'team') {
        // Small delay to ensure the team wrappers are visible
        setTimeout(updateTeamSizeFromSelection, 50);
      }
    });
  });

  if (typeInput && typeInput.value === 'team') {
    updateTeamSizeFromSelection();
  }
}

function initCalendarModals() {
  resetCalendarModals();

  var registerModal         = document.getElementById("register-modal");
  var registerModalContent  = document.getElementById("register-modal-content");
  var authModal             = document.getElementById("auth-required-modal");
  var authModalContent      = document.getElementById("auth-required-modal-content");
  var teamMembersWrapperRef = document.getElementById("team-members-wrapper");

  [registerModal, authModal].forEach(function (modal) {
    if (!modal) return;
    modal.querySelectorAll("[data-modal-dismiss]").forEach(function (el) {
      el.addEventListener("click", function () {
        closeCalendarModal(modal);
      });
    });
  });

  document.querySelectorAll("[data-open-register-modal]").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var signedIn   = btn.dataset.userSignedIn === "true";
      var matchId    = btn.dataset.matchId;
      var title      = btn.dataset.matchTitle || "Match";
      var city       = btn.dataset.matchCity || "";
      var datetime   = btn.dataset.matchDatetime || "";
      var metaString = [city, datetime].filter(Boolean).join(" · ");

      if (signedIn) {
        if (!registerModal || !registerModalContent) return;

        var titleEl         = document.getElementById("register-modal-title");
        var metaEl          = document.getElementById("register-modal-meta");
        var idInput         = document.getElementById("register-match-id");
        var typeInput       = document.getElementById("register-type-input");
        var teamWrapper     = document.getElementById("team-size-wrapper");
        var userTeamWrapper = document.getElementById("user-team-wrapper");
        var teamMembersList = document.getElementById("team-members-list");

        if (titleEl) titleEl.textContent = "Registrera dig till match";
        if (metaEl)  metaEl.textContent  = metaString;
        if (idInput) idInput.value       = matchId;

        // Reset type selection to individual
        if (typeInput) typeInput.value = "individual";
        if (teamWrapper) teamWrapper.classList.add("hidden");
        if (userTeamWrapper) userTeamWrapper.classList.add("hidden");
        if (teamMembersWrapperRef) teamMembersWrapperRef.classList.add("hidden");
        if (teamMembersList) teamMembersList.innerHTML = "";

        document.querySelectorAll(".js-register-type-btn").forEach(function (tbtn) {
          tbtn.dataset.active = (tbtn.dataset.type === "individual") ? "true" : "false";
        });

        openCalendarModal(registerModal, registerModalContent);
      } else {
        if (!authModal || !authModalContent) return;
        openCalendarModal(authModal, authModalContent);
      }
    });
  });

  document.querySelectorAll(".js-register-type-btn").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var selectedType       = btn.dataset.type;
      var typeInput          = document.getElementById("register-type-input");
      var teamWrapper        = document.getElementById("team-size-wrapper");
      var userTeamWrapper    = document.getElementById("user-team-wrapper");
      var teamMembersWrapper = document.getElementById("team-members-wrapper");

      document.querySelectorAll(".js-register-type-btn").forEach(function (b) {
        b.dataset.active = (b === btn) ? "true" : "false";
      });

      if (typeInput) typeInput.value = selectedType;

      if (selectedType === "team") {
        if (teamWrapper)        teamWrapper.classList.remove("hidden");
        if (userTeamWrapper)    userTeamWrapper.classList.remove("hidden");
        if (teamMembersWrapper) teamMembersWrapper.classList.remove("hidden");
      } else {
        if (teamWrapper)        teamWrapper.classList.add("hidden");
        if (userTeamWrapper)    userTeamWrapper.classList.add("hidden");
        if (teamMembersWrapper) teamMembersWrapper.classList.add("hidden");
      }
    });
  });
}

function initCityDropdown() {
  var wrapper = document.querySelector("[data-city-select-wrapper]");
  if (!wrapper) return;
  if (wrapper.dataset.bound === "true") return;
  wrapper.dataset.bound = "true";

  var button = wrapper.querySelector("[data-city-select-button]");
  var menu   = wrapper.querySelector("[data-city-select-menu]");
  var input  = wrapper.querySelector("#dashboard-city-input");
  var form   = wrapper.closest("form");

  if (!button || !menu || !input || !form) return;

  button.addEventListener("click", function () {
    menu.classList.toggle("hidden");
  });

  menu.querySelectorAll("[data-city-option]").forEach(function (opt) {
    opt.addEventListener("click", function () {
      var value = opt.dataset.value || "";
      var label = opt.dataset.label || "Alla städer";
      var color = opt.dataset.color || "#e5e7eb";

      input.value = value;

      var dot     = button.querySelector("[data-city-dot]");
      var labelEl = button.querySelector("[data-city-label]");

      if (dot)     dot.style.backgroundColor = color;
      if (labelEl) labelEl.textContent       = label;

      menu.classList.add("hidden");
      form.submit();
    });
  });

  document.addEventListener("click", function (e) {
    if (!wrapper.contains(e.target)) {
      menu.classList.add("hidden");
    }
  });
}

function initDashboardUI() {
  initCalendarModals();
  initCityDropdown();
  initTeamRegistration();
}

document.addEventListener("DOMContentLoaded", initDashboardUI);
document.addEventListener("turbo:load", initDashboardUI);
document.addEventListener("turbo:render", initDashboardUI);

document.addEventListener("turbo:before-cache", function () {
  var wrapper = document.querySelector("[data-city-select-wrapper]");
  if (!wrapper) return;

  wrapper.removeAttribute("data-bound");

  var menu = wrapper.querySelector("[data-city-select-menu]");
  if (menu) {
    menu.classList.add("hidden");
  }
});
</script>
