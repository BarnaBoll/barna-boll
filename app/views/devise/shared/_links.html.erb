<% links = [] %>

<% if controller_name != "sessions" %>
  <% links << link_to("Logga in", new_session_path(resource_name), class: "hover:text-orange-300") %>
<% end %>

<% if devise_mapping.registerable? && controller_name != "registrations" %>
  <% links << link_to("Skapa konto", new_registration_path(resource_name), class: "hover:text-orange-300") %>
<% end %>

<% if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
  <% links << link_to("Glömt lösenord?", new_password_path(resource_name), class: "hover:text-orange-300") %>
<% end %>

<% if devise_mapping.confirmable? && controller_name != "confirmations" %>
  <% links << link_to("Fick du inget bekräftelsemail?", new_confirmation_path(resource_name), class: "hover:text-orange-300") %>
<% end %>

<% if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != "unlocks" %>
  <% links << link_to("Fick du inget upplåsningsmail?", new_unlock_path(resource_name), class: "hover:text-orange-300") %>
<% end %>

<% if devise_mapping.omniauthable? %>
  <% resource_class.omniauth_providers.each do |provider| %>
    <% links << button_to(
      "Logga in med #{OmniAuth::Utils.camelize(provider)}",
      omniauth_authorize_path(resource_name, provider),
      data: { turbo: false },
      class: "inline-flex items-center rounded-full border border-slate-700 px-3 py-1 text-xs hover:border-orange-400 hover:text-orange-300"
    ) %>
  <% end %>
<% end %>

<% if links.any? %>
  <div class="mt-5 flex flex-wrap gap-2 text-[11px] text-slate-400">
    <% links.each do |link| %>
      <span class="inline-flex items-center gap-1 rounded-full bg-slate-900/70 px-3 py-1 border border-slate-800">
        <span class="h-1 w-1 rounded-full bg-slate-600"></span>
        <%= link %>
      </span>
    <% end %>
  </div>
<% end %>
