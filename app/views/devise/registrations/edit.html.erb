<% content_for :title, "Konto – Barnaboll" %>

<div class="min-h-[calc(100vh-5rem)] flex items-center justify-center bg-slate-950 text-slate-50">
  <div class="w-full max-w-lg px-4">
    <!-- Header -->
    <header class="mb-6 text-center space-y-3">
      <div class="flex items-center justify-center gap-3">
        <%= link_to root_path do %>
          <%= image_tag "logo.svg",
                        alt: "Barnaboll",
                        class: "h-10 w-auto rounded-xl shadow-lg shadow-orange-500/30" %>
        <% end %>

        <div class="flex items-center gap-2 text-[11px] font-semibold tracking-[0.26em] uppercase">
          <span class="text-orange-300">Barnaboll</span>
          <span class="h-1 w-1 rounded-full bg-orange-400"></span>
          <span class="text-amber-200">Konto</span>
        </div>
      </div>

      <h1 class="text-3xl font-semibold tracking-tight text-slate-50">
        Uppdatera dina uppgifter
      </h1>
      <p class="text-xs text-slate-400 max-w-md mx-auto">
        Ändra namn, e-post eller lösenord för ditt Barnaboll-konto.
      </p>
    </header>

    <!-- Card -->
    <div class="relative overflow-hidden rounded-[2rem] border border-slate-800 bg-slate-950/85 shadow-[0_0_80px_rgba(15,23,42,0.9)] px-5 py-6 sm:px-6 sm:py-7 space-y-6">
      <div class="pointer-events-none absolute -top-16 -right-10 h-32 w-32 rounded-full bg-orange-500/20 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-12 left-0 h-28 w-40 rounded-full bg-pink-500/15 blur-3xl"></div>

      <div class="relative space-y-5">
        <%= form_for(resource,
                     as: resource_name,
                     url: registration_path(resource_name),
                     html: { method: :put, class: "space-y-4" }) do |f| %>

          <%= render "devise/shared/error_messages", resource: resource %>

          <div>
            <%= f.label :name, "Namn", class: "block text-xs font-semibold text-slate-300 mb-1" %>
            <%= f.text_field :name,
                             class: "w-full rounded-2xl border border-slate-700 bg-slate-950/60 px-4 py-2.5 text-sm text-slate-100 placeholder:text-slate-500 focus:border-orange-300 focus:outline-none focus:ring-0" %>
          </div>

          <div>
            <%= f.label :email, "E-post", class: "block text-xs font-semibold text-slate-300 mb-1" %>
            <%= f.email_field :email,
                              autocomplete: "email",
                              class: "w-full rounded-2xl border border-slate-700 bg-slate-950/60 px-4 py-2.5 text-sm text-slate-100 placeholder:text-slate-500 focus:border-orange-300 focus:outline-none focus:ring-0" %>
          </div>

          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <p class="text-[11px] text-slate-500">
              Väntar på bekräftelse av:
              <span class="font-medium"><%= resource.unconfirmed_email %></span>
            </p>
          <% end %>

          <div>
            <div class="flex items-center justify-between text-xs mb-1">
              <%= f.label :password, "Nytt lösenord", class: "font-semibold text-slate-300" %>
              <span class="text-[11px] text-slate-500">
                Lämna tomt om du inte vill ändra.
              </span>
            </div>
            <%= f.password_field :password,
                                 autocomplete: "new-password",
                                 class: "w-full rounded-2xl border border-slate-700 bg-slate-950/60 px-4 py-2.5 text-sm text-slate-100 placeholder:text-slate-500 focus:border-orange-300 focus:outline-none focus:ring-0" %>
            <% if @minimum_password_length %>
              <p class="mt-1 text-[11px] text-slate-500">
                Minst <%= @minimum_password_length %> tecken.
              </p>
            <% end %>
          </div>

          <div>
            <%= f.label :password_confirmation, "Bekräfta nytt lösenord", class: "block text-xs font-semibold text-slate-300 mb-1" %>
            <%= f.password_field :password_confirmation,
                                 autocomplete: "new-password",
                                 class: "w-full rounded-2xl border border-slate-700 bg-slate-950/60 px-4 py-2.5 text-sm text-slate-100 placeholder:text-slate-500 focus:border-orange-300 focus:outline-none focus:ring-0" %>
          </div>

          <div>
            <%= f.label :current_password, "Nuvarande lösenord", class: "block text-xs font-semibold text-slate-300 mb-1" %>
            <p class="text-[11px] text-slate-500 mb-1">
              Vi behöver ditt nuvarande lösenord för att bekräfta ändringarna.
            </p>
            <%= f.password_field :current_password,
                                 autocomplete: "current-password",
                                 class: "w-full rounded-2xl border border-slate-700 bg-slate-950/60 px-4 py-2.5 text-sm text-slate-100 placeholder:text-slate-500 focus:border-orange-300 focus:outline-none focus:ring-0" %>
          </div>

          <div class="pt-2 flex flex-wrap gap-3">
            <%= f.submit "Spara ändringar",
                         class: "inline-flex flex-1 items-center justify-center rounded-full px-5 py-2.5 text-sm font-semibold text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 shadow-lg shadow-orange-900/40 hover:from-orange-300 hover:to-pink-400 transition" %>
          </div>
        <% end %>

        <div class="rounded-2xl border border-red-500/30 bg-red-950/40 px-4 py-4">
          <h2 class="text-sm font-semibold text-red-200 mb-1">
            Avsluta konto
          </h2>
          <p class="text-[11px] text-red-100/80 mb-3">
            Om du tar bort ditt konto raderas dina uppgifter och du kan inte längre logga in med samma konto.
          </p>

          <%= button_to "Ta bort konto",
                        registration_path(resource_name),
                        method: :delete,
                        data: { confirm: "Är du säker?", turbo_confirm: "Är du säker?" },
                        class: "inline-flex items-center rounded-full border border-red-400/80 px-4 py-2 text-xs font-semibold text-red-100 hover:bg-red-500/15" %>
        </div>

        <div class="text-[11px] text-slate-500">
          <%= link_to "Tillbaka till dashboard", authenticated_root_path, class: "hover:text-orange-300" %>
        </div>
      </div>
    </div>
  </div>
</div>
