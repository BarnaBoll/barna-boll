<% content_for :title, "#{@match.title} – Match" %>

<div class="min-h-[calc(100vh-5rem)] bg-slate-950 text-slate-50">
  <div class="max-w-4xl mx-auto px-4 py-8 space-y-6">

    <!-- Header -->
    <section class="rounded-2xl border border-slate-800 bg-slate-950/70 p-5 space-y-2">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-[11px] uppercase tracking-[0.18em] text-orange-300 mb-1">
            Matchdetaljer
          </p>

          <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight">
            <%= @match.title %>
          </h1>

          <p class="text-xs text-slate-400 mt-1">
            <%= (@match.city&.name || "—") %>
            <% if @match.location.present? %> · <%= @match.location.name %><% end %>
            · <%= l(@match.date, format: :long) rescue @match.date.to_s %>
            <% if @match.time.present? %> · <span class="font-mono"><%= @match.time.strftime("%H:%M") %></span><% end %>
          </p>

          <% if @match.price.present? %>
            <p class="text-xs text-slate-400 mt-1"><%= @match.price.to_i %> kr</p>
          <% end %>

          <% if @match.description.present? %>
            <p class="text-sm text-slate-300 mt-3 max-w-2xl"><%= @match.description %></p>
          <% end %>
        </div>

        <div class="text-right">
          <% booked = @match.total_players %>
          <% cap = @match.hard_limit_total.to_i %>
          <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500">Platser</p>
          <p class="font-mono text-slate-100 text-sm"><%= booked %> / <%= cap %></p>
          <p class="text-[11px] text-slate-500 mt-1">
            <%= @match.hard_limit_reached? ? "Fullbokat" : "Platser kvar" %>
          </p>

          <div class="mt-3">
            <%= link_to "Tillbaka till kalendern",
                        schedule_path,
                        class: "text-[11px] text-slate-400 hover:text-orange-300" %>
          </div>
        </div>
      </div>
    </section>

    <!-- Teams + registrations -->
    <section class="grid gap-4 md:grid-cols-3">
      <% @teams.each do |team| %>
        <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4">
          <div class="flex items-center justify-between mb-2">
            <h2 class="text-sm font-semibold"><%= team.name.presence || "Team" %></h2>
            <span class="font-mono text-[11px] text-slate-400">
              <%= team.current_players %> / <%= team.capacity_soft %>
            </span>
          </div>

          <% regs = team.registrations.confirmed.includes(:user, :user_team) %>

          <% if regs.blank? %>
            <p class="text-xs text-slate-500">Inga anmälningar ännu.</p>
          <% else %>
            <ul class="space-y-2">
              <% regs.each do |reg| %>
                <li class="rounded-xl border border-slate-800 bg-slate-900/70 px-3 py-2">
                  <p class="text-[11px] text-slate-200 font-semibold">
                    <% if reg.user_team.present? %>
                      <%= reg.user_team.name %>
                      <span class="text-slate-500 font-normal">· lag</span>
                    <% else %>
                      <%= reg.user&.name_or_email || "Spelare" %>
                      <span class="text-slate-500 font-normal">· individuell</span>
                    <% end %>
                  </p>

                  <p class="text-[11px] text-slate-400 mt-0.5">
                    Platser: <span class="font-mono text-slate-200"><%= reg.team_size %></span>
                    <% if reg.user.present? %>
                      · Bokad av <span class="font-mono text-slate-200"><%= reg.user.name_or_email %></span>
                    <% end %>
                  </p>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>
      <% end %>
    </section>

  </div>
</div>
