<% content_for :title, "Admin – #{@city.name}" %>

<div class="min-h-[calc(100vh-5rem)] bg-slate-950 text-slate-50">
  <div class="max-w-5xl mx-auto px-4 py-8 space-y-6">
    <header class="flex items-center justify-between gap-4">
      <div>
        <p class="text-[11px] uppercase tracking-[0.2em] text-orange-300 mb-1">
          Admin · Stad
        </p>
        <h1 class="text-2xl font-semibold tracking-tight"><%= @city.name %></h1>
        <% if @city.description.present? %>
          <p class="text-sm text-slate-400"><%= @city.description %></p>
        <% end %>
      </div>

      <div class="flex flex-col sm:flex-row gap-2">
        <%= link_to "Redigera",
                    edit_admin_city_path(@city),
                    class: "inline-flex items-center justify-center rounded-full px-5 py-2 text-[11px] sm:text-xs font-semibold text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 hover:from-orange-300 hover:to-pink-400 transition" %>

        <%= button_to "Ta bort",
                      admin_city_path(@city),
                      method: :delete,
                      data: { confirm: "Är du säker på att du vill ta bort den här staden?" },
                      class: "inline-flex items-center justify-center rounded-full px-4 py-2 text-[11px] font-semibold border border-red-500/60 text-red-300 hover:bg-red-500/10" %>
      </div>
    </header>

    <section class="space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-slate-100">Platser</h2>
        <%= link_to "Ny plats",
                    new_admin_city_location_path(@city),
                    class: "text-[11px] rounded-full border border-slate-700 px-3 py-1 border-slate-700 text-slate-200 hover:border-orange-400  " %>
      </div>

      <% if @locations.any? %>
        <div class="grid gap-3 md:grid-cols-2">
          <% @locations.each do |location| %>
            <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-3 space-y-1">
              <div class="flex items-center justify-between">
                <p class="text-sm font-semibold"><%= location.name %></p>
                <%= link_to "Visa",
                            admin_city_location_path(@city, location),
                            class: "text-[11px] text-orange-300 hover:text-orange-200" %>
              </div>
              <% if location.address.present? %>
                <p class="text-xs text-slate-400"><%= location.address %></p>
              <% end %>
              <% if location.description.present? %>
                <p class="text-[11px] text-slate-500"><%= location.description %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-slate-400">Inga platser i den här staden ännu.</p>
      <% end %>
    </section>

    <section class="space-y-3">
      <h2 class="text-sm font-semibold text-slate-100">Kommande matcher</h2>
      <% if @upcoming_matches.any? %>
        <div class="border border-slate-800 rounded-2xl bg-slate-950/70 overflow-hidden">
          <table class="min-w-full text-sm">
            <thead class="bg-slate-950/80 text-[11px] uppercase tracking-[0.18em] text-slate-500 border-b border-slate-800">
              <tr>
                <th class="px-4 py-2 text-left">Titel</th>
                <th class="px-4 py-2 text-left">Datum</th>
                <th class="px-4 py-2 text-left">Plats</th>
                <th class="px-4 py-2 text-right">Åtgärder</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800">
              <% @upcoming_matches.each do |match| %>
                <tr>
                  <td class="px-4 py-2"><%= match.title %></td>
                  <td class="px-4 py-2 text-xs text-slate-300">
                    <%= l(match.date, format: :short) if match.date %>
                    <% if match.time %>
                      · <%= match.time.strftime("%H:%M") %>
                    <% end %>
                  </td>
                  <td class="px-4 py-2 text-xs text-slate-300">
                    <%= match.location.name %>
                  </td>
                  <td class="px-4 py-2 text-right">
                    <%= link_to "Visa",
                                admin_match_path(match),
                                class: "text-[11px] rounded-full border border-slate-700 px-3 py-1 hover:border-pink-400 hover:text-pink-300" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-slate-400">Inga kommande matcher för den här staden.</p>
      <% end %>
    </section>
  </div>
</div>
