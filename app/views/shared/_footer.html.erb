<footer class="border-t border-slate-800/80 bg-slate-950">
  <div class="max-w-5xl mx-auto px-4 py-8 space-y-6">

    <!-- Top: brand + link columns -->
    <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
      <!-- Brand / tagline -->
      <div class="flex items-start gap-3">
        <%= image_tag "barnaboll_logo.jpg",
                      alt: "Barnaboll logo",
                      class: "h-8 w-8 rounded-2xl border border-slate-700 object-cover shadow-lg shadow-orange-900/40" %>

        <div class="space-y-1">
          <p class="text-xs font-semibold text-slate-100 tracking-tight">
            Barnaboll <span class="text-orange-300">Football</span>
          </p>
          <p class="text-[11px] text-slate-500 max-w-xs">
            Winner-stays-on football sessions in Malmö, Uppsala, Stockholm &amp; Göteborg – pace, level and community.
          </p>
        </div>
      </div>

      <!-- Link groups -->
      <div class="grid grid-cols-2 gap-6 text-[11px] text-slate-400 sm:grid-cols-3">
        <!-- Sessions / product -->
        <div class="space-y-2">
          <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">
            Sessions
          </p>
          <ul class="space-y-1.5">
            <li><%= link_to "Features", features_path, class: "hover:text-orange-300" %></li>
            <li><%= link_to "Business", business_path, class: "hover:text-orange-300" %></li>
            <li><%= link_to "Help & FAQ", help_path, class: "hover:text-orange-300" %></li>
          </ul>
        </div>

        <!-- Company -->
        <div class="space-y-2">
          <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">
            Company
          </p>
          <ul class="space-y-1.5">
            <li><%= link_to "About Barnaboll", about_path, class: "hover:text-orange-300" %></li>
            <li><%= link_to "Contact", contact_path, class: "hover:text-orange-300" %></li>
            <li>
              <%= link_to "@barnaboll on Instagram",
                          "https://www.instagram.com/barnaboll/",
                          target: "_blank",
                          rel: "noopener",
                          class: "hover:text-orange-300" %>
            </li>
          </ul>
        </div>

        <!-- Legal -->
        <div class="space-y-2">
          <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">
            Legal
          </p>
          <ul class="space-y-1.5">
            <li><%= link_to "Privacy Policy", privacy_path, class: "hover:text-orange-300" %></li>
            <li><%= link_to "Terms of Service", terms_path, class: "hover:text-orange-300" %></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom strip -->
    <div class="border-t border-slate-800/80 pt-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between text-[11px] text-slate-500">
      <p>
        &copy; 2022 Barnaboll. All rights reserved.
      </p>
      <p class="text-slate-600">
        Community-driven football. Not connected to any team or club.
      </p>
    </div>
  </div>
</footer>
