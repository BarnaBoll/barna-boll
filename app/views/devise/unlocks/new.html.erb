<% content_for :title, "Lås upp konto – Barnaboll" %>

<div class="min-h-[calc(100vh-5rem)] flex items-center justify-center bg-slate-950 text-slate-50">
  <div class="w-full max-w-md px-4">
    <div class="relative overflow-hidden rounded-[1.75rem] border border-slate-800 bg-slate-950/80 shadow-2xl shadow-slate-950/80 px-6 py-7">
      <div class="pointer-events-none absolute -top-16 -right-16 h-32 w-32 rounded-full bg-orange-500/20 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-10 left-10 h-24 w-40 rounded-full bg-pink-500/15 blur-3xl"></div>

      <div class="relative space-y-6">
        <header class="space-y-2">
          <h1 class="text-xl font-semibold tracking-tight">
            Lås upp ditt konto
          </h1>
          <p class="text-xs text-slate-400">
            Om ditt konto låsts efter många misslyckade försök kan du få ett upplåsningsmail.
          </p>
        </header>

        <%= form_for(resource,
                     as: resource_name,
                     url: unlock_path(resource_name),
                     html: { method: :post, class: "space-y-4" }) do |f| %>

          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="space-y-1">
            <%= f.label :email, "E-post", class: "block text-xs font-medium text-slate-300" %>
            <%= f.email_field :email,
                              autofocus: true,
                              autocomplete: "email",
                              class: "w-full rounded-xl border border-slate-700 bg-slate-900/80 px-3 py-2 text-sm text-slate-50 placeholder:text-slate-500 focus:border-orange-400 focus:outline-none focus:ring-2 focus:ring-orange-500/40" %>
          </div>

          <div class="pt-2">
            <%= f.submit "Skicka upplåsningsmail",
                         class: "w-full inline-flex items-center justify-center rounded-full bg-gradient-to-r from-orange-400 to-pink-500 px-4 py-2.5 text-sm font-semibold text-slate-950 shadow-lg shadow-orange-900/40 hover:from-orange-300 hover:to-pink-400 transition" %>
          </div>
        <% end %>

        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
