<% content_for :title, "Barnaboll – Fotboll som den ska spelas" %>
<% content_for :meta_description, "Barnaboll är en fotbollscommunity för spelare som vill ha tempo, nivå och gemenskap. Winner-stays-on-sessioner i Malmö, Uppsala, Stockholm & Göteborg." %>

<%
  city_colors = (@city_colors || {}).transform_keys { |k| k.to_s.downcase }
%>

<style>
  @keyframes float-soft {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  .floating-soft {
    animation: float-soft 8s ease-in-out infinite;
  }

  /* Generic elevated card hover */
  .bb-card-elevated {
    position: relative;
    transition:
      transform 220ms ease-out,
      box-shadow 220ms ease-out,
      border-color 220ms ease-out,
      background 220ms ease-out;
  }
  .bb-card-elevated:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.95);
    border-color: rgba(148, 163, 184, 0.7);
    background: radial-gradient(circle at top, rgba(148, 163, 184, 0.16), rgba(15, 23, 42, 0.98));
  }

  /* Gentle gradient border wrapper */
  .bb-gradient-shell {
    position: relative;
    border-radius: 1.75rem;
    overflow: hidden;
  }
  .bb-gradient-shell::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(248, 250, 252, 0.3), rgba(248, 250, 252, 0.01));
    opacity: 0.25;
    pointer-events: none;
  }

  /* City cards: subtle glow on hover */
  .bb-city-card {
    position: relative;
    overflow: hidden;
  }
  .bb-city-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at top, rgba(248, 250, 252, 0.12), transparent 60%);
    opacity: 0;
    transition: opacity 200ms ease-out;
    pointer-events: none;
  }
  .bb-city-card:hover::before {
    opacity: 1;
  }

  /* Timeline feel for "Så funkar" bullets */
  .bb-step-list li {
    position: relative;
    padding-left: 1.3rem;
  }
  .bb-step-list li::before {
    content: "";
    position: absolute;
    left: 0.25rem;
    top: 0.35rem;
    width: 0.2rem;
    height: 0.2rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #fb923c, #f97316);
    box-shadow: 0 0 0 4px rgba(248, 250, 252, 0.02);
  }
  .bb-step-list li::after {
    content: "";
    position: absolute;
    left: 0.33rem;
    top: 1.1rem;
    bottom: -0.8rem;
    width: 1px;
    background: linear-gradient(to bottom, rgba(148, 163, 184, 0.6), transparent);
  }
  .bb-step-list li:last-child::after {
    display: none;
  }

  /* Highlights: soft zoom + gradient edge */
  .bb-highlight-card {
    position: relative;
    overflow: hidden;
    transition: transform 220ms ease-out, box-shadow 220ms ease-out;
  }
  .bb-highlight-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.95);
  }
  .bb-highlight-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 1.5rem;
    border: 1px solid rgba(148, 163, 184, 0.25);
    mix-blend-mode: screen;
    pointer-events: none;
  }

  /* Section subtle separators without hard lines */
  .bb-section-shell {
    position: relative;
  }
  .bb-section-shell::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    width: 72%;
    transform: translateX(-50%);
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      rgba(148, 163, 184, 0.45),
      transparent
    );
    opacity: 0.25;
  }
</style>

<div class="space-y-14 sm:space-y-16">

  <!-- HERO: full-bleed, hugs header -->
  <section
    class="relative w-screen left-1/2 -translate-x-1/2 -mt-6 sm:-mt-6 bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 text-white overflow-hidden"
  >
    <!-- subtle noise / glow -->
    <div class="pointer-events-none absolute inset-0 opacity-40">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(248,250,252,0.08),_transparent_55%),radial-gradient(circle_at_bottom,_rgba(15,23,42,0.85),_transparent_55%)]"></div>
    </div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20">
      <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-16">
        <!-- Left: copy -->
        <div class="w-full lg:w-1/2">
          <p class="text-[11px] font-semibold tracking-[0.25em] uppercase text-orange-300 mb-3">
            Barnaboll · Winner stays on
          </p>

          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-5">
            Fotboll som den
            <span class="bg-gradient-to-r from-orange-400 via-amber-300 to-pink-400 bg-clip-text text-transparent">
              ska spelas.
            </span>
          </h1>

          <p class="text-sm sm:text-base text-slate-200 max-w-xl mb-7">
            Barnaboll är en fotbollscommunity för spelare som vill ha tempo, nivå och gemenskap.
            Winner-stays-on sessions i Malmö, Uppsala, Stockholm &amp; Göteborg – du tar med skorna,
            vi fixar resten.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 mb-5">
            <%= link_to "Boka via Instagram DM",
                        "https://www.instagram.com/barnaboll/",
                        target: "_blank",
                        rel: "noopener",
                        class: "inline-flex justify-center items-center rounded-xl px-7 py-3 text-sm font-semibold bg-gradient-to-r from-orange-400 to-pink-500 text-slate-950 shadow-[0_14px_40px_rgba(249,115,22,0.65)] hover:brightness-110 hover:-translate-y-[1px] transition-transform duration-150" %>

            <%= link_to "Se highlights",
                        "https://www.instagram.com/barnaboll/reels/",
                        target: "_blank",
                        rel: "noopener",
                        class: "inline-flex justify-center items-center rounded-xl px-7 py-3 text-sm font-semibold border border-slate-500/80 text-slate-100 bg-slate-900/40 hover:bg-slate-900/70 hover:border-orange-400/70 hover:text-orange-100 transition" %>
          </div>

          <div class="flex flex-wrap gap-3 text-xs text-slate-400">
            <span class="inline-flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-orange-400"></span>
              Winner-stays-on-format
            </span>
            <span class="inline-flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              Fyra städer · fasta tider
            </span>
            <span class="inline-flex items-center gap-2">
              <span class="h-1.5 w-1.5 rounded-full bg-pink-400"></span>
              Tempo, nivå &amp; respekt på planen
            </span>
          </div>
        </div>

        <!-- Right: hero image / card -->
        <div class="w-full lg:w-1/2 flex justify-center">
          <div class="relative w-full max-w-md">
            <div class="absolute -top-10 -left-10 w-32 h-32 bg-orange-500/25 rounded-full blur-3xl"></div>
            <div class="absolute -bottom-10 -right-10 w-36 h-36 bg-pink-500/25 rounded-full blur-3xl"></div>

            <div class="bb-gradient-shell floating-soft bg-slate-900/80 border border-slate-800/70 shadow-xl">
              <%= image_tag "hero_bg.jpg",
                            alt: "Barnaboll match",
                            class: "w-full h-64 sm:h-72 md:h-80 object-cover" %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- soft fade into page background -->
    <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-slate-950 to-transparent pointer-events-none"></div>
  </section>

  <!-- Cities / feature cards -->
  <section class="bb-section-shell">
    <div class="max-w-5xl mx-auto px-4 py-10 sm:py-12">
      <h2 class="text-base font-semibold text-slate-100 mb-1">
        Fyra städer, samma vibe.
      </h2>
      <p class="text-sm text-slate-400 mb-6">
        Oavsett om du spelar i Malmö, Uppsala, Stockholm eller Göteborg ska Barnaboll kännas likadant:
        tempo, nivå och respekt på planen.
      </p>

      <div class="grid gap-4 text-sm md:grid-cols-4">
        <% [
          ["Malmö", "Där allt började. Intensiva matcher och fasta tider."],
          ["Uppsala", "Tekniska lirare, mycket tempo, mycket snack."],
          ["Stockholm", "Fredagsfotboll när den är som bäst."],
          ["Göteborg", "Resan fortsätter – nyaste tillskottet i BARNA-familjen."]
        ].each do |city, copy| %>
          <% raw_color = city_colors[city.downcase].to_s.strip %>
          <% if raw_color.present? && raw_color.start_with?("#") %>
            <% card_style = "background-image: linear-gradient(135deg, #{raw_color}22, #{raw_color}05); border-color: #{raw_color}55;" %>
          <% else %>
            <% card_style = nil %>
          <% end %>

          <div class="bb-card-elevated bb-city-card rounded-2xl border border-slate-800 bg-slate-950/70 p-4"
               style="<%= card_style %>">
            <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500 mb-1">
              Stad
            </p>
            <h3 class="font-semibold text-slate-100 mb-1 text-sm"><%= city %></h3>
            <p class="text-[12px] text-slate-300"><%= copy %></p>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!--  REGISTER FOR MATCHES   -->
  <section
    class="relative w-screen left-1/2 -translate-x-1/2 overflow-hidden bg-gradient-to-r from-slate-950 via-slate-900 to-slate-950"
  >
    <!-- subtle colored glows / texture -->
    <div class="pointer-events-none absolute inset-0 opacity-40">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_left,_rgba(248,250,252,0.04),_transparent_60%),radial-gradient(circle_at_right,_rgba(251,146,60,0.18),_transparent_55%)]"></div>
    </div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-12 flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-10">
      <div class="flex-1">
        <p class="text-[11px] uppercase tracking-[0.18em] text-slate-300 mb-2">
          Nästa steg
        </p>
        <h2 class="text-xl sm:text-2xl font-semibold text-slate-50 mb-2">
          Hitta en match och säkra din plats
        </h2>
        <p class="text-sm text-slate-200 max-w-xl">
          Öppna schemat för att se alla kommande matcher. Välj stad, datum och tid – boka själv eller tillsammans
          med ditt lag på några sekunder.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
        <%= link_to "Öppna schema & matcher",
                    schedule_path,
                    class: "inline-flex justify-center items-center rounded-full px-6 py-2.5 text-sm font-semibold bg-orange-400 text-slate-950 hover:bg-orange-300 shadow-[0_10px_35px_rgba(249,115,22,0.6)] hover:-translate-y-[1px] transition-transform duration-150 w-full sm:w-auto" %>

        <%= link_to "Logga in för att boka",
                    new_user_session_path,
                    class: "inline-flex justify-center items-center rounded-full px-6 py-2.5 text-sm font-semibold border border-slate-500/80 text-slate-50 bg-slate-900/40 hover:bg-slate-900/70 hover:border-orange-400/70 hover:text-orange-100 transition w-full sm:w-auto" %>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="bb-section-shell">
    <div class="max-w-5xl mx-auto px-4 py-10 sm:py-12 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="text-base font-semibold text-slate-100 mb-2">
          Så funkar Barnaboll.
        </h2>
        <p class="text-sm text-slate-400 mb-4">
          Vi vill göra det enkelt att spela fotboll på bra nivå – utan att vara låst till ett lag.
          Du dyker upp, vi fixar hall, upplägg och vibe.
        </p>
        <ul class="bb-step-list space-y-3 text-sm text-slate-300">
          <li>
            Vi släpper kommande sessions på Instagram <span class="font-semibold">@barnaboll</span>.
          </li>
          <li>
            Du anmäler dig via DM med namn, stad, nivå och om du kommer själv eller med vänner.
          </li>
          <li>
            Vi bekräftar din plats och skickar tid, plats och format (t.ex. futsal / 5v5).
          </li>
          <li>
            På plats kör vi winner-stays-on – du ger allt på planen, vi sköter rotation och struktur.
          </li>
        </ul>
        <p class="mt-4 text-xs text-slate-500">
          Nivån ska vara hög men inkluderande: du behöver inte vara proffs, men du ska gilla att tävla.
        </p>
      </div>

      <div class="space-y-4">
        <div>
          <h3 class="text-sm font-semibold text-slate-100 mb-2">
            Vad du alltid kan räkna med
          </h3>
          <ul class="space-y-2 text-xs text-slate-400">
            <li>Fasta starttider och tydlig kommunikation innan varje session.</li>
            <li>Strukturerat upplägg med korta, intensiva matcher och snabba byten.</li>
            <li>Schysst stämning: hårt spel är okej, skitbeteende är det inte.</li>
          </ul>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-slate-100 mb-2">
            För vem?
          </h3>
          <ul class="space-y-2 text-xs text-slate-400">
            <li>Dig som saknar omklädningsrummet men inte vill spela seriesystem.</li>
            <li>Kompisgäng som vill ha en återkommande session med hög nivå.</li>
            <li>Spelare från olika klubbar som vill mötas på neutral mark.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- REGISTER / COMMUNITY   -->
  <section
    class="relative w-screen left-1/2 -translate-x-1/2 overflow-hidden bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950"
  >
    <!-- subtle glow background -->
    <div class="pointer-events-none absolute inset-0 opacity-50">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_left,_rgba(251,146,60,0.22),_transparent_60%),radial-gradient(circle_at_right,_rgba(34,197,94,0.20),_transparent_60%)]"></div>
    </div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-12 space-y-6">
      <div class="text-center">
        <p class="text-[11px] uppercase tracking-[0.18em] text-slate-300 mb-2">
          Nästa steg
        </p>
        <h2 class="text-xl sm:text-2xl font-semibold text-slate-50">
          Hitta matcher, boka plats & håll koll på communityn
        </h2>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        <!-- Instagram card -->
        <div class="relative rounded-[1.75rem] border border-orange-400/30 bg-slate-950/80 px-6 py-7 shadow-[0_0_60px_rgba(249,115,22,0.15)]">
          <div class="pointer-events-none absolute inset-0 rounded-[1.75rem] border border-orange-400/10"></div>

          <h3 class="text-sm font-semibold text-slate-50 mb-2 text-center md:text-left">
            Boka via Instagram
          </h3>
          <p class="text-sm text-slate-300 mb-5 text-center md:text-left">
            Se highlights, nya sessions och boka din plats via DM. Perfekt om du vill hoppa in på nästa
            Barnaboll–kväll.
          </p>

          <div class="flex justify-center md:justify-start">
            <%= link_to "@barnaboll på Instagram",
                        "https://www.instagram.com/barnaboll/",
                        target: "_blank",
                        rel: "noopener",
                        class: "inline-flex items-center justify-center rounded-full px-8 py-2.5 text-sm font-semibold text-slate-950 bg-gradient-to-r from-orange-400 via-amber-300 to-pink-500 shadow-[0_12px_30px_rgba(15,23,42,0.8)] border border-orange-200/70 hover:brightness-110 hover:-translate-y-[1px] transition-transform duration-150" %>
          </div>

          <p class="mt-4 text-[11px] text-slate-500 text-center md:text-left">
            Skriv din stad, nivå och om du kommer själv eller med vänner.
          </p>
        </div>

        <!-- WhatsApp card -->
        <div class="relative rounded-[1.75rem] border border-emerald-400/40 bg-slate-950/80 px-6 py-7 shadow-[0_0_60px_rgba(16,185,129,0.18)]">
          <div class="pointer-events-none absolute inset-0 rounded-[1.75rem] border border-emerald-400/10"></div>

          <h3 class="text-sm font-semibold text-slate-50 mb-2 text-center md:text-left">
            Gå med i WhatsApp–gruppen
          </h3>
          <p class="text-sm text-slate-300 mb-5 text-center md:text-left">
            Få snabba uppdateringar om nya tider, sista-minuten-platser och spontanmöten direkt i mobilen.
          </p>

          <div class="flex justify-center md:justify-start">
            <%= link_to "Gå med i WhatsApp–gruppen",
                        "https://chat.whatsapp.com/REPLACE_WITH_INVITE_LINK",
                        target: "_blank",
                        rel: "noopener",
                        class: "inline-flex items-center justify-center rounded-full px-8 py-2.5 text-sm font-semibold text-slate-950 bg-gradient-to-r from-emerald-400 via-emerald-300 to-lime-300 shadow-[0_12px_30px_rgba(15,23,42,0.8)] border border-emerald-200/80 hover:brightness-110 hover:-translate-y-[1px] transition-transform duration-150" %>
          </div>

          <p class="mt-4 text-[11px] text-slate-500 text-center md:text-left">
            Funkar bäst i mobilen om du har WhatsApp installerat.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Highlights gallery -->
  <section id="highlights" class="bb-section-shell">
    <div class="max-w-5xl mx-auto px-4 py-10 sm:py-12">
      <div class="flex items-center justify-between gap-4 mb-4">
        <div>
          <h2 class="text-base font-semibold text-slate-100">
            Highlights från planen.
          </h2>
          <p class="text-sm text-slate-400">
            Ett smakprov från Barna Cupen och våra sessions.
          </p>
        </div>
        <%= link_to "@barnaboll reels",
                    "https://www.instagram.com/barnaboll/reels/",
                    target: "_blank",
                    rel: "noopener",
                    class: "hidden sm:inline-flex items-center rounded-full border border-slate-700 px-3 py-1 text-[11px] font-semibold text-slate-200 hover:border-pink-400 hover:text-pink-300 transition" %>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        <% [
          ["Barna Cupen", "Turnering med fullt ös och publik.", "barna_cupen.jpg"],
          ["Indoor session", "Intensiv futsal och snabba byten.", "image_1.jpg"],
          ["Matchmoment", "Winner-stays-on och tajta matcher.", "image_2.jpg"]
        ].each do |title, copy, image_name| %>
          <div class="bb-highlight-card group relative rounded-3xl border border-slate-800 bg-slate-950/60 shadow-lg shadow-slate-950/50">
            <div class="aspect-[4/5] overflow-hidden">
              <%= image_tag image_name,
                            alt: title,
                            class: "h-full w-full object-cover transition duration-500 group-hover:scale-105 group-hover:brightness-110" %>
            </div>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/15 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-4">
              <p class="text-xs font-semibold text-slate-50 mb-0.5"><%= title %></p>
              <p class="text-[11px] text-slate-300"><%= copy %></p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>
</div>
