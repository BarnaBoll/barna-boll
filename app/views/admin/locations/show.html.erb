<% content_for :title, "Admin – #{@location.name} (#{@city.name})" %>
<% content_for :meta_description, "Detaljer för platsen #{@location.name} i #{@city.name}." %>

<div class="min-h-[calc(100vh-5rem)] bg-slate-950 text-slate-50">
  <div class="max-w-5xl mx-auto px-4 py-8 space-y-6">
    <header class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <p class="text-[11px] uppercase tracking-[0.2em] text-orange-300 mb-1">
          Admin · Plats
        </p>
        <h1 class="text-2xl font-semibold tracking-tight">
          <%= @location.name %>
        </h1>
        <p class="text-sm text-slate-400">
          <%= @city.name %>
        </p>
        <% if @location.address.present? %>
          <p class="text-xs text-slate-400 mt-1">
            <%= @location.address %>
          </p>
        <% end %>
      </div>

      <div class="flex flex-col sm:flex-row gap-2">
        <%= link_to "Redigera",
                    edit_admin_city_location_path(@city, @location),
                    class: "inline-flex items-center justify-center rounded-full px-5 py-2 text-[11px] sm:text-xs font-semibold text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 shadow-lg shadow-orange-900/40 hover:from-orange-300 hover:to-pink-400 transition" %>

        <%= button_to "Ta bort",
                      admin_city_location_path(@city, @location),
                      method: :delete,
                      data: { confirm: "Är du säker på att du vill ta bort den här platsen?" },
                      class: "inline-flex items-center justify-center rounded-full px-4 py-2 text-[11px] font-semibold border border-red-500/60 text-red-300 hover:bg-red-500/10" %>
      </div>
    </header>

    <section class="grid gap-4 md:grid-cols-2">
      <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4 text-sm space-y-2">
        <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-[0.18em] mb-1">
          Information
        </h2>

        <% if @location.description.present? %>
          <p class="text-sm text-slate-200"><%= @location.description %></p>
        <% else %>
          <p class="text-sm text-slate-400">Ingen beskrivning angiven.</p>
        <% end %>
      </div>

      <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4 text-sm space-y-2">
        <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-[0.18em] mb-1">
          Statistik (enkel)
        </h2>
        <p class="text-sm text-slate-300">
          Matcher på den här platsen: <%= @location.matches.count %>
        </p>
      </div>
    </section>

    <section class="space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-slate-100">
          Matcher på den här platsen
        </h2>
        <%= link_to "Ny match",
                    new_admin_match_path(match: { city_id: @city.id, location_id: @location.id }),
                    class: "text-[11px] rounded-full border border-slate-700 px-3 py-1 hover:border-orange-400" %>
      </div>

      <% matches = @location.matches.order(date: :desc, time: :desc) %>
      <% if matches.any? %>
        <div class="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-950/70">
          <table class="min-w-full text-sm">
            <thead class="bg-slate-950/80 border-b border-slate-800 text-[11px] uppercase tracking-[0.18em] text-slate-500">
              <tr>
                <th class="px-4 py-2 text-left">Titel</th>
                <th class="px-4 py-2 text-left">Datum</th>
                <th class="px-4 py-2 text-right">Platser (bokade / max)</th>
                <th class="px-4 py-2 text-right">Åtgärder</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800">
              <% matches.each do |match| %>
                <tr>
                  <td class="px-4 py-2">
                    <%= link_to match.title,
                                admin_match_path(match),
                                class: "text-slate-100" %>
                  </td>
                  <td class="px-4 py-2 text-xs text-slate-300">
                    <% if match.date %>
                      <%= l(match.date, format: :short) %>
                    <% end %>
                    <% if match.time %>
                      · <%= match.time.strftime("%H:%M") %>
                    <% end %>
                  </td>
                  <td class="px-4 py-2 text-right text-xs text-slate-300">
                    <% booked = match.total_players %>
                    <%= booked %> / <%= match.hard_limit_total %>
                  </td>
                  <td class="px-4 py-2 text-right">
                    <%= link_to "Visa",
                                admin_match_path(match),
                                class: "text-[11px] rounded-full border border-slate-700 px-3 py-1 hover:border-orange-400" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-slate-400">
          Inga matcher kopplade till den här platsen ännu.
        </p>
      <% end %>
    </section>

    <section class="pt-2">
      <%= link_to "Tillbaka till staden",
                  admin_city_path(@city),
                  class: "text-[11px] text-slate-400 hover:text-orange-300" %>
    </section>
  </div>
</div>
