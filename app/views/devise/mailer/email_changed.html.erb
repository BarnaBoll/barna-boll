<div style="font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background-color:#020617; color:#e2e8f0; padding:24px;">
  <div style="max-width:480px;margin:0 auto;border-radius:18px;border:1px solid #1f2937;background:#020617;padding:24px;">
    <h1 style="font-size:18px;margin:0 0 12px;color:#f9fafb;">Your email was updated</h1>

    <p style="font-size:14px;margin:0 0 12px;">
      Hello <strong><%= @email %></strong>,
    </p>

    <% if @resource.try(:unconfirmed_email?) %>
      <p style="font-size:14px;margin:0 0 12px;">
        We're contacting you to let you know your email is being changed to
        <strong><%= @resource.unconfirmed_email %></strong>.
      </p>
    <% else %>
      <p style="font-size:14px;margin:0 0 12px;">
        We're contacting you to let you know your email has been changed to
        <strong><%= @resource.email %></strong>.
      </p>
    <% end %>

    <p style="font-size:12px;color:#94a3b8;margin:0;">
      If this wasn't you, please update your details or contact support.
    </p>
  </div>
</div>
