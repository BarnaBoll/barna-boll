<% content_for :title, "Admin – Dashboard" %>
<% content_for :meta_description, "Adminöversikt för Barnaboll – hantera användare, städer, platser och matcher." %>

<div class="min-h-[calc(100vh-5rem)] bg-slate-950 text-slate-50">
  <div class="max-w-5xl mx-auto px-4 py-8 space-y-6">
    <!-- Header -->
    <header class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-[11px] uppercase tracking-[0.2em] text-orange-300 mb-1">
          Admin
        </p>
        <h1 class="text-2xl font-semibold tracking-tight">Dashboard</h1>
        <p class="text-sm text-slate-400">
          Snabb överblick över Barnaboll – användare, städer, platser och matcher.
        </p>
      </div>

      <div class="flex flex-wrap gap-2 justify-start md:justify-end">
        <%= link_to "Hantera användare",
                    admin_users_path,
                    class: "inline-flex items-center justify-center rounded-full px-4 py-2.5 text-[11px] sm:text-xs font-semibold text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 shadow-lg shadow-orange-900/40 hover:from-orange-300 hover:to-pink-400 transition" %>

        <%= link_to "Städer & platser",
                    admin_cities_path,
                    class: "inline-flex items-center justify-center rounded-full px-4 py-2.5 text-[11px] sm:text-xs font-semibold border border-slate-700 text-slate-200 hover:border-orange-400 " %>

        <%= link_to "Matcher",
                    admin_matches_path,
                    class: "inline-flex items-center justify-center rounded-full px-4 py-2.5 text-[11px] sm:text-xs font-semibold border border-slate-700 text-slate-200 hover:border-orange-400 " %>
      </div>
    </header>

    <!-- Top stats: users & admin -->
    <div class="grid gap-4 md:grid-cols-3">
      <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4">
        <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500 mb-1">
          Totalt antal användare
        </p>
        <p class="text-2xl font-semibold"><%= @users_count %></p>
      </div>

      <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4">
        <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500 mb-1">
          Admins
        </p>
        <p class="text-2xl font-semibold"><%= @admins_count %></p>
      </div>

      <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4">
        <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500 mb-1">
          Inloggad som
        </p>
        <p class="text-sm font-medium"><%= current_user.name_or_email %></p>
        <p class="text-[11px] text-slate-400 mt-1">Admin: <%= current_user.admin? ? "Ja" : "Nej" %></p>
      </div>
    </div>

    <!-- System overview: cities / locations / matches -->
    <section class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4 space-y-3">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-sm font-semibold text-slate-100">
            Struktur – städer, platser och matcher
          </h2>
          <p class="text-xs text-slate-400">
            Snabb överblick över hur mycket som är uppsatt i systemet.
          </p>
        </div>

        <div class="hidden sm:flex gap-2">
          <%= link_to "Städer & platser",
                      admin_cities_path,
                      class: "text-[11px] rounded-full border border-slate-700 px-3 py-1 hover:border-orange-400 " %>
          <%= link_to "Matcher",
                      admin_matches_path,
                      class: "text-[11px] rounded-full border border-slate-700 px-3 py-1 hover:border-orange-400 " %>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead class="bg-slate-950/80 border-b border-slate-800 text-[11px] uppercase tracking-[0.18em] text-slate-500">
            <tr>
              <th class="px-4 py-2 text-left">Resurstyp</th>
              <th class="px-4 py-2 text-left">Antal</th>
              <th class="px-4 py-2 text-left">Primär åtgärd</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800">
            <tr>
              <td class="px-4 py-2 text-slate-100">Städer</td>
              <td class="px-4 py-2 text-slate-200"><%= @cities_count %></td>
              <td class="px-4 py-2">
                <%= link_to "Hantera städer",
                            admin_cities_path,
                            class: "text-[11px] rounded-full border border-slate-700 px-3 py-1 hover:border-orange-400 " %>
              </td>
            </tr>
            <tr>
              <td class="px-4 py-2 text-slate-100">Platser</td>
              <td class="px-4 py-2 text-slate-200"><%= @locations_count %></td>
              <td class="px-4 py-2">
                <%= link_to "Via städer",
                            admin_cities_path,
                            class: "text-[11px] rounded-full border border-slate-700 px-3 py-1 hover:border-orange-400 " %>
              </td>
            </tr>
            <tr>
              <td class="px-4 py-2 text-slate-100">Matcher</td>
              <td class="px-4 py-2 text-slate-200"><%= @matches_count %></td>
              <td class="px-4 py-2">
                <%= link_to "Hantera matcher",
                            admin_matches_path,
                            class: "text-[11px] rounded-full border border-slate-700 px-3 py-1 hover:border-orange-400 " %>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Upcoming matches -->
    <section class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4 space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold text-slate-100">
          Kommande matcher
        </h2>
        <%= link_to "Alla matcher",
                    admin_matches_path,
                    class: "text-[11px] text-orange-300 hover:text-orange-200" %>
      </div>

      <% if @upcoming_matches.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead class="bg-slate-950/80 border-b border-slate-800 text-[11px] uppercase tracking-[0.18em] text-slate-500">
              <tr>
                <th class="px-4 py-2 text-left">Titel</th>
                <th class="px-4 py-2 text-left">Stad</th>
                <th class="px-4 py-2 text-left">Plats</th>
                <th class="px-4 py-2 text-left">Datum</th>
                <th class="px-4 py-2 text-right">Platser (bokade / max)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800">
              <% @upcoming_matches.each do |match| %>
                <tr>
                  <td class="px-4 py-2">
                    <%= link_to match.title,
                                admin_match_path(match),
                                class: "text-slate-100 " %>
                  </td>
                  <td class="px-4 py-2 text-xs text-slate-300"><%= match.city.name %></td>
                  <td class="px-4 py-2 text-xs text-slate-300"><%= match.location.name %></td>
                  <td class="px-4 py-2 text-xs text-slate-300">
                    <% if match.date %>
                      <%= l(match.date, format: :short) %>
                    <% end %>
                    <% if match.time %>
                      · <%= match.time.strftime("%H:%M") %>
                    <% end %>
                  </td>
                  <td class="px-4 py-2 text-right text-xs text-slate-300">
                    <% booked = match.total_players %>
                    <%= booked %> / <%= match.hard_limit_total %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-slate-400">Inga kommande matcher inlagda ännu.</p>
      <% end %>
    </section>

    <!-- Recent users -->
    <section class="border border-slate-800 rounded-2xl bg-slate-950/70 p-4">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-sm font-semibold text-slate-100">
          Senaste användare
        </h2>
        <%= link_to "Visa alla",
                    admin_users_path,
                    class: "text-[11px] text-orange-300 hover:text-orange-200" %>
      </div>

      <% if @recent_users.any? %>
        <div class="divide-y divide-slate-800">
          <% @recent_users.each do |user| %>
            <div class="flex items-center justify-between py-2 text-sm">
              <div>
                <p class="font-medium text-slate-50"><%= user.name_or_email %></p>
                <p class="text-[11px] text-slate-400">
                  Skapad <%= l(user.created_at, format: :short) %>
                  <% if user.admin? %>
                    · <span class="text-orange-300 font-medium">Admin</span>
                  <% end %>
                </p>
              </div>
              <div class="flex items-center gap-2">
                <%= link_to "Visa",
                            admin_user_path(user),
                            class: "text-[11px] rounded-full border border-slate-700 px-3 py-1 hover:border-orange-400 " %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-slate-400">Inga användare ännu.</p>
      <% end %>
    </section>
  </div>
</div>
