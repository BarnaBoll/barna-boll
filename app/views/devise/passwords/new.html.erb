<% content_for :title, "Glömt lösenord – Barnaboll" %>
<% content_for :meta_description,
  "Glömt lösenordet till ditt Barnaboll-konto? Ange din e-postadress för att få en länk och återställa ditt lösenord." %>

<div class="min-h-[calc(100vh-5rem)] flex items-center justify-center bg-slate-950 text-slate-50">
  <div class="w-full max-w-md px-4">
    <!-- Header -->
    <header class="mb-6 text-center space-y-3">
      <div class="flex items-center justify-center gap-3">
        <%= link_to root_path do %>
          <%= image_tag "logo.svg",
                        alt: "Barnaboll",
                        class: "h-10 w-auto rounded-xl shadow-lg shadow-orange-500/30" %>
        <% end %>

        <div class="flex items-center gap-2 text-[11px] font-semibold tracking-[0.26em] uppercase">
          <span class="text-orange-300">Barnaboll</span>
          <span class="h-1 w-1 rounded-full bg-orange-400"></span>
          <span class="text-amber-200">Lösenord</span>
        </div>
      </div>

      <h1 class="text-3xl font-semibold tracking-tight text-slate-50">
        Glömt lösenordet?
      </h1>
      <p class="text-xs text-slate-400 max-w-sm mx-auto">
        Ange din e-postadress så skickar vi en länk för att återställa ditt lösenord.
      </p>
    </header>

    <!-- Card -->
    <div class="relative overflow-hidden rounded-[2rem] border border-slate-800 bg-slate-950/85 shadow-[0_0_80px_rgba(15,23,42,0.9)] px-5 py-6 sm:px-6 sm:py-7">
      <div class="pointer-events-none absolute -top-16 -right-10 h-32 w-32 rounded-full bg-orange-500/20 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-12 left-0 h-28 w-40 rounded-full bg-pink-500/15 blur-3xl"></div>

      <div class="relative">
        <%= form_for(resource,
                     as: resource_name,
                     url: password_path(resource_name),
                     html: { method: :post, class: "space-y-4" }) do |f| %>

          <%= render "devise/shared/error_messages", resource: resource %>

          <div>
            <%= f.label :email, "E-post", class: "block text-xs font-semibold text-slate-300 mb-1" %>
            <%= f.email_field :email,
                              autofocus: true,
                              autocomplete: "email",
                              placeholder: "namn@example.com",
                              class: "w-full rounded-2xl border border-slate-700 bg-slate-950/60 px-4 py-2.5 text-sm text-slate-100 placeholder:text-slate-500 focus:border-orange-300 focus:outline-none focus:ring-0" %>
          </div>

          <div class="pt-2">
            <%= f.submit "Skicka återställningslänk",
                         class: "w-full inline-flex items-center justify-center rounded-full px-5 py-2.5 text-sm font-semibold text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 shadow-lg shadow-orange-900/40 hover:from-orange-300 hover:to-pink-400 transition" %>
          </div>
        <% end %>

        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
