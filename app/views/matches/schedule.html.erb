<% content_for :title, "Matchkalender – Barnaboll" %>
<% content_for :meta_description, "Se alla kommande Barnaboll-matcher och sessions. Filtrera på stad och se tider per vecka, månad eller som lista." %>

<div class="min-h-[calc(100vh-5rem)] bg-slate-950 text-slate-50">
  <div class="max-w-5xl mx-auto px-4 py-8 space-y-6">

    <!-- Header / filters -->
    <section class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-[11px] uppercase tracking-[0.2em] text-orange-300 mb-1">
          Matchkalender
        </p>
        <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight">
          Kommande matcher &amp; sessions
        </h1>
        <p class="text-sm text-slate-400 mt-1">
          Bläddra bland kommande matcher, filtrera på stad och hitta nästa session att spela.
        </p>
      </div>

      <!-- Right side: city filter + view toggle + period nav -->
      <div class="w-full md:w-auto flex flex-col items-stretch md:items-end gap-2">
        <!-- Row: city select + view toggle -->
        <div class="w-full md:w-auto flex flex-col sm:flex-row sm:items-center sm:justify-between md:justify-end gap-3">
          <!-- City filter -->
          <%= form_with url: schedule_path,
                        method: :get,
                        local: true,
                        class: "text-xs w-full sm:w-auto" do %>
            <div class="relative inline-flex w-full sm:w-auto items-center gap-2 rounded-full border border-slate-700 bg-slate-900/80 pl-3 pr-1 py-1.5"
                 data-city-select-wrapper>
              <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-500">
                Stad
              </span>

              <% current_city_label = @selected_city&.name || "Alla städer" %>
              <% current_city_color = @selected_city_color.presence || "#e5e7eb" %>

              <%= hidden_field_tag :city, params[:city].to_s, id: "calendar-city-input" %>
              <%= hidden_field_tag :view, @view %>
              <%= hidden_field_tag :start, @reference_date.iso8601 %>

              <button type="button"
                      data-city-select-button
                      class="flex-1 inline-flex items-center justify-between gap-2 rounded-full bg-transparent px-2 py-0.5 text-[11px] text-slate-100 focus:outline-none">
                <span class="inline-flex items-center gap-2 min-w-0">
                  <span class="h-1.5 w-1.5 rounded-full shrink-0"
                        data-city-dot
                        style="background-color: <%= current_city_color %>;"></span>
                  <span data-city-label class="truncate"><%= current_city_label %></span>
                </span>
                <span class="ml-1 text-[10px] text-slate-400 shrink-0">▾</span>
              </button>

              <div data-city-select-menu
                   class="absolute z-30 top-full mt-2 right-0 w-56 rounded-2xl border border-slate-700 bg-slate-900/95 shadow-xl py-1 hidden">
                <button type="button"
                        class="w-full flex items-center gap-2 px-3 py-1.5 text-[11px] text-slate-100 text-left hover:bg-slate-800/80"
                        data-city-option
                        data-value=""
                        data-label="Alla städer"
                        data-color="#e5e7eb">
                  <span class="h-1.5 w-1.5 rounded-full"
                        style="background-color: #e5e7eb;"></span>
                  <span>Alla städer</span>
                </button>

                <% @cities.each do |city| %>
                  <% value = city.to_param %>
                  <% color =
                       if city.respond_to?(:accent_color) && city.accent_color.present?
                         city.accent_color
                       elsif city.respond_to?(:color_hex) && city.color_hex.present?
                         city.color_hex
                       elsif city.respond_to?(:primary_color) && city.primary_color.present?
                         city.primary_color
                       elsif city.respond_to?(:color) && city.color.present?
                         city.color
                       else
                         "#f97316"
                       end %>
                  <button type="button"
                          class="w-full flex items-center gap-2 px-3 py-1.5 text-[11px] text-slate-100 text-left hover:bg-slate-800/80"
                          data-city-option
                          data-value="<%= value %>"
                          data-label="<%= city.name %>"
                          data-color="<%= color %>">
                    <span class="h-1.5 w-1.5 rounded-full"
                          style="background-color: <%= color %>;"></span>
                    <span><%= city.name %></span>
                  </button>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- View toggle -->
          <div class="flex items-center text-[11px] rounded-full border border-slate-700 bg-slate-900/70 px-1 py-1 w-full sm:w-auto">
            <%= link_to schedule_path(view: :week, city: params[:city], start: @reference_date.iso8601),
                        class: "flex-1 rounded-full px-3 py-1 text-center font-semibold #{@view == 'week' ? 'bg-slate-50 text-slate-900' : 'text-slate-300 hover:text-orange-300'}" do %>
              Vecka
            <% end %>

            <%= link_to schedule_path(view: :month, city: params[:city], start: @reference_date.iso8601),
                        class: "flex-1 rounded-full px-3 py-1 text-center font-semibold #{@view == 'month' ? 'bg-slate-50 text-slate-900' : 'text-slate-300 hover:text-orange-300'}" do %>
              Månad
            <% end %>

            <%= link_to schedule_path(view: :list, city: params[:city], start: @reference_date.iso8601),
                        class: "flex-1 rounded-full px-3 py-1 text-center font-semibold #{@view == 'list' ? 'bg-slate-50 text-slate-900' : 'text-slate-300 hover:text-orange-300'}" do %>
              Lista
            <% end %>
          </div>
        </div>

        <!-- Period nav -->
        <div class="flex items-center justify-between md:justify-end text-[11px] text-slate-400 gap-2 w-full md:w-auto">
          <% prev_ref =
               case @view
               when "week"  then (@reference_date - 7.days)
               when "month" then (@reference_date - 1.month)
               else              (@reference_date - 30.days)
               end %>

          <% next_ref =
               case @view
               when "week"  then (@reference_date + 7.days)
               when "month" then (@reference_date + 1.month)
               else              (@reference_date + 30.days)
               end %>

          <% period_label =
               case @view
               when "month"
                 begin
                   l(@reference_date, format: :long)[0..-6] rescue @reference_date.strftime("%B %Y")
                 rescue
                   @reference_date.strftime("%B %Y")
                 end
               else
                 "#{l(@start_date, format: :short)} – #{l(@end_date, format: :short)}"
               end %>

          <%= link_to "← Föregående",
                      schedule_path(view: @view, city: params[:city], start: prev_ref.iso8601),
                      class: "hover:text-orange-300" %>

          <span class="text-[10px] text-slate-500">
            <%= period_label %>
          </span>

          <%= link_to "Nästa →",
                      schedule_path(view: @view, city: params[:city], start: next_ref.iso8601),
                      class: "hover:text-orange-300" %>
        </div>
      </div>
    </section>

    <!-- Legend -->
    <section class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4 text-xs text-slate-400 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
        <div class="h-7 w-7 rounded-full bg-gradient-to-tr from-orange-400 to-pink-500 flex items-center justify-center text-[11px] font-semibold text-slate-950 border border-slate-900/50">
          ⚽
        </div>
        <div>
          <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500">
            Översikt
          </p>
          <p class="text-xs text-slate-300">
            Du kan boka plats direkt från kalendern när du är inloggad.
          </p>
        </div>
      </div>
      <div class="flex flex-wrap gap-3 mt-2 sm:mt-0">
        <span class="inline-flex items-center gap-1">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
          <span>Platser kvar</span>
        </span>
        <span class="inline-flex items-center gap-1">
          <span class="h-2 w-2 rounded-full bg-amber-300"></span>
          <span>Nära fullt</span>
        </span>
        <span class="inline-flex items-center gap-1">
          <span class="h-2 w-2 rounded-full bg-rose-400"></span>
          <span>Fullbokat</span>
        </span>
      </div>
    </section>

    <!-- Calendar / list -->
    <section class="space-y-4">
      <% if @view == "list" %>
        <% if @matches_by_date.blank? %>
          <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-5 text-sm text-slate-300">
            Inga kommande matcher hittades för den här perioden.
          </div>
        <% else %>
          <% @matches_by_date.sort_by { |date, _| date || Date.today }.each do |date, matches_for_day| %>
            <div class="rounded-2xl border border-slate-800 bg-slate-950/70 overflow-hidden">
              <div class="flex items-center justify-between bg-slate-950/80 border-b border-slate-800 px-4 py-2.5">
                <div>
                  <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500">
                    <%= (l(date, format: :weekday) rescue date.to_s) %>
                  </p>
                  <p class="text-sm font-semibold text-slate-100">
                    <%= (l(date, format: :long) rescue date.to_s) %>
                  </p>
                </div>
              </div>

              <div class="divide-y divide-slate-800">
                <% matches_for_day.each do |match| %>
                  <% booked   = match.total_players %>
                  <% capacity = match.hard_limit_total || 0 %>
                  <% ratio    = capacity.positive? ? (booked.to_f / capacity.to_f) : 0.0 %>
                  <% status_color =
                       if capacity.zero?
                         "bg-slate-500"
                       elsif ratio >= 1.0
                         "bg-rose-400"
                       elsif ratio >= 0.7
                         "bg-amber-300"
                       else
                         "bg-emerald-400"
                       end %>

                  <% city_dot_color = match.city&.color.presence || "#f97316" %>

                  <% already_registered =
                       if user_signed_in?
                         match.registrations.where(user_id: current_user.id).exists? ||
                           match.registrations.where(user_team_id: current_user.user_teams.select(:id)).exists?
                       else
                         false
                       end %>

                  <% full = capacity.positive? && booked >= capacity %>
                  <% disabled = full || already_registered %>

                  <div class="px-4 py-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <div class="space-y-1 min-w-0">
                      <div class="flex flex-wrap items-center gap-2 min-w-0">
                        <p class="text-sm font-semibold text-slate-100 truncate">
                          <%= match.title %>
                        </p>
                        <span class="inline-flex items-center gap-1 rounded-full border border-slate-700 px-2 py-0.5 text-[11px] text-slate-300">
                          <span class="h-1.5 w-1.5 rounded-full"
                                style="background-color: <%= city_dot_color %>;"></span>
                          <%= match.city.name %>
                        </span>
                        <% if match.location.present? %>
                          <span class="inline-flex items-center gap-1 rounded-full border border-slate-700 px-2 py-0.5 text-[11px] text-slate-300">
                            <%= match.location.name %>
                          </span>
                        <% end %>
                      </div>

                      <p class="text-xs text-slate-400">
                        <% if match.time %>
                          <span class="font-mono text-slate-200">
                            <%= match.time.strftime("%H:%M") %>
                          </span>
                          ·
                        <% end %>
                        <% if match.price.present? %>
                          <span><%= match.price.to_i %> kr</span>
                        <% else %>
                          <span>Pris info via DM</span>
                        <% end %>
                      </p>

                      <% if match.description.present? %>
                        <p class="text-[11px] text-slate-400 max-w-xl">
                          <%= truncate(match.description, length: 120) %>
                        </p>
                      <% end %>

                      <div class="pt-0.5">
                        <%= link_to match_path(match),
                                    class: "text-[11px] text-slate-400 hover:text-orange-300 inline-flex items-center gap-1" do %>
                          <span class="hidden sm:inline">Detaljer</span>
                          <span class="sm:hidden">ℹ︎</span>
                        <% end %>
                      </div>
                    </div>

                    <div class="flex flex-col items-stretch gap-2 sm:items-end sm:text-right">
                      <div class="w-full sm:w-40">
                        <div class="flex items-center justify-between text-[11px] text-slate-400 mb-0.5">
                          <span>Platser</span>
                          <span class="font-mono text-slate-200">
                            <%= booked %> / <%= capacity %>
                          </span>
                        </div>
                        <div class="h-1.5 w-full rounded-full bg-slate-800 overflow-hidden">
                          <div class="h-full <%= status_color %>"
                               style="width: <%= [[(ratio * 100).round, 0].max, 100].min %>%;">
                          </div>
                        </div>
                      </div>

                      <button
                        type="button"
                        class="mt-1 inline-flex items-center justify-center rounded-full px-3 py-1.5 text-[11px] font-semibold whitespace-nowrap <%= disabled ? 'text-slate-300 bg-slate-800 cursor-not-allowed' : 'text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 hover:from-orange-300 hover:to-pink-400' %>"
                        <% unless disabled %>
                          data-open-register-modal
                          data-match-id="<%= match.id %>"
                          data-match-title="<%= match.title %>"
                          data-match-city="<%= match.city.name %>"
                          data-match-datetime="<%= [
                            (l(match.date, format: :short) rescue match.date.to_s),
                            (match.time&.strftime('%H:%M'))
                          ].compact.join(' · ') %>"
                          data-user-signed-in="<%= user_signed_in? %>"
                        <% end %>>
                        <% if full %>
                          Fullbokat
                        <% elsif already_registered %>
                          <span class="hidden sm:inline">Redan anmäld</span>
                          <span class="sm:hidden">Anmäld</span>
                        <% else %>
                          Boka plats
                        <% end %>
                      </button>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>

      <% elsif @view == "week" %>
        <!-- WEEK VIEW (improved) -->

        <!-- Mobile: agenda list by day -->
        <div class="space-y-3 md:hidden">
          <% (@start_date..@end_date).each do |day| %>
            <% day_matches = @matches_by_date[day] || [] %>
            <div class="rounded-2xl border border-slate-800 bg-slate-950/70 overflow-hidden">
              <div class="px-4 py-2.5 border-b border-slate-800 bg-slate-950/80">
                <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500">
                  <%= (l(day, format: :weekday) rescue day.strftime("%A")) %>
                </p>
                <p class="text-sm font-semibold text-slate-100">
                  <%= (l(day, format: :long) rescue day.to_s) %>
                </p>
              </div>

              <% if day_matches.blank? %>
                <div class="px-4 py-3 text-xs text-slate-400">
                  Inga matcher.
                </div>
              <% else %>
                <div class="divide-y divide-slate-800">
                  <% day_matches.each do |match| %>
                    <% booked   = match.total_players %>
                    <% capacity = match.hard_limit_total || 0 %>
                    <% ratio    = capacity.positive? ? (booked.to_f / capacity.to_f) : 0.0 %>
                    <% full     = capacity.positive? && booked >= capacity %>

                    <% already_registered =
                         if user_signed_in?
                           match.registrations.where(user_id: current_user.id).exists? ||
                             match.registrations.where(user_team_id: current_user.user_teams.select(:id)).exists?
                         else
                           false
                         end %>

                    <% disabled = full || already_registered %>
                    <% city_dot_color = match.city&.color.presence || "#f97316" %>

                    <div class="px-4 py-3 flex flex-col gap-2">
                      <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                          <p class="text-sm font-semibold text-slate-100 truncate">
                            <%= match.title %>
                          </p>
                          <p class="text-[11px] text-slate-400 mt-0.5">
                            <% if match.time %>
                              <span class="font-mono text-slate-200"><%= match.time.strftime("%H:%M") %></span>
                              ·
                            <% end %>
                            <span class="inline-flex items-center gap-1">
                              <span class="h-1.5 w-1.5 rounded-full"
                                    style="background-color: <%= city_dot_color %>;"></span>
                              <%= match.city.name %>
                            </span>
                            <% if match.location.present? %> · <%= match.location.name %><% end %>
                          </p>
                          <div class="pt-1">
                            <%= link_to match_path(match),
                                        class: "text-[11px] text-slate-400 hover:text-orange-300 inline-flex items-center gap-1" do %>
                              <span class="hidden sm:inline">Detaljer</span>
                              <span class="sm:hidden">ℹ︎</span>
                            <% end %>
                          </div>
                        </div>

                        <div class="shrink-0 text-right">
                          <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500">Platser</p>
                          <p class="font-mono text-[11px] text-slate-200"><%= booked %> / <%= capacity %></p>
                        </div>
                      </div>

                      <button
                        type="button"
                        class="inline-flex items-center justify-center rounded-full px-3 py-2 text-[11px] font-semibold whitespace-nowrap <%= disabled ? 'text-slate-300 bg-slate-800 cursor-not-allowed' : 'text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 hover:from-orange-300 hover:to-pink-400' %>"
                        <% unless disabled %>
                          data-open-register-modal
                          data-match-id="<%= match.id %>"
                          data-match-title="<%= match.title %>"
                          data-match-city="<%= match.city.name %>"
                          data-match-datetime="<%= [
                            (l(match.date, format: :short) rescue match.date.to_s),
                            (match.time&.strftime('%H:%M'))
                          ].compact.join(' · ') %>"
                          data-user-signed-in="<%= user_signed_in? %>"
                        <% end %>>
                        <% if full %>
                          Fullbokat
                        <% elsif already_registered %>
                          Anmäld
                        <% else %>
                          Boka plats
                        <% end %>
                      </button>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Desktop: 7-column week with larger panels -->
        <div class="hidden md:block rounded-2xl border border-slate-800 bg-slate-950/70 overflow-hidden">
          <div class="grid grid-cols-7 gap-px bg-slate-800/60">
            <% (@start_date..@end_date).each do |day| %>
              <% day_matches = @matches_by_date[day] || [] %>
              <div class="bg-slate-950/90 p-3 min-h-[280px] flex flex-col">
                <div class="flex items-baseline justify-between mb-2">
                  <div class="min-w-0">
                    <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500">
                      <%= (l(day, format: :weekday) rescue day.strftime("%a")) %>
                    </p>
                    <p class="text-sm font-semibold text-slate-100">
                      <%= day.day %>
                    </p>
                  </div>
                  <span class="text-[11px] text-slate-500">
                    <%= (l(day, format: :short) rescue day.to_s) %>
                  </span>
                </div>

                <% if day_matches.blank? %>
                  <p class="text-xs text-slate-500 mt-2">Inga matcher</p>
                <% else %>
                  <div class="space-y-2">
                    <% day_matches.each do |match| %>
                      <% booked   = match.total_players %>
                      <% capacity = match.hard_limit_total || 0 %>
                      <% full     = capacity.positive? && booked >= capacity %>

                      <% already_registered =
                           if user_signed_in?
                             match.registrations.where(user_id: current_user.id).exists? ||
                               match.registrations.where(user_team_id: current_user.user_teams.select(:id)).exists?
                           else
                             false
                           end %>

                      <% disabled = full || already_registered %>

                      <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-3">
                        <div class="flex items-start justify-between gap-2">
                          <div class="min-w-0">
                            <p class="text-sm font-semibold text-slate-100 truncate">
                              <%= match.title %>
                            </p>
                            <p class="text-[11px] text-slate-400 mt-0.5 truncate">
                              <%= match.city.name %><% if match.location.present? %> · <%= match.location.name %><% end %>
                            </p>
                          </div>
                          <% if match.time %>
                            <span class="font-mono text-[11px] text-slate-200 shrink-0">
                              <%= match.time.strftime("%H:%M") %>
                            </span>
                          <% end %>
                        </div>

                        <div class="flex items-center justify-between mt-2">
                          <%= link_to match_path(match),
                                      class: "text-[11px] text-slate-400 hover:text-orange-300 inline-flex items-center gap-1" do %>
                            Detaljer <span aria-hidden="true">→</span>
                          <% end %>

                          <span class="font-mono text-[11px] text-slate-300">
                            <%= booked %> / <%= capacity %>
                          </span>
                        </div>

                        <button
                          type="button"
                          class="mt-2 w-full inline-flex items-center justify-center rounded-full px-3 py-2 text-[11px] font-semibold whitespace-nowrap <%= disabled ? 'text-slate-300 bg-slate-800 cursor-not-allowed' : 'text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 hover:from-orange-300 hover:to-pink-400' %>"
                          <% unless disabled %>
                            data-open-register-modal
                            data-match-id="<%= match.id %>"
                            data-match-title="<%= match.title %>"
                            data-match-city="<%= match.city.name %>"
                            data-match-datetime="<%= [
                              (l(match.date, format: :short) rescue match.date.to_s),
                              (match.time&.strftime('%H:%M'))
                            ].compact.join(' · ') %>"
                            data-user-signed-in="<%= user_signed_in? %>"
                          <% end %>>
                          <% if full %>
                            Fullbokat
                          <% elsif already_registered %>
                            Redan anmäld
                          <% else %>
                            Boka plats
                          <% end %>
                        </button>
                      </div>
                    <% end %>
                  </div>
                <% end %>

              </div>
            <% end %>
          </div>
        </div>

      <% else %>
        <!-- MONTH VIEW (grid) -->
        <div class="rounded-2xl border border-slate-800 bg-slate-950/70 overflow-hidden">
          <div class="grid grid-cols-7 gap-px bg-slate-800/60 text-[11px]">
            <% (@start_date..@end_date).each do |day| %>
              <% day_matches = @matches_by_date[day] || [] %>
              <div class="min-h-[112px] bg-slate-950/90 p-1.5 flex flex-col min-w-0">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-[10px] uppercase tracking-[0.16em] text-slate-500">
                    <%= day.strftime("%a") %>
                  </span>
                  <span class="text-[11px] font-semibold text-slate-100">
                    <%= day.day %>
                  </span>
                </div>

                <div class="space-y-1 min-w-0">
                  <% day_matches.each do |match| %>
                    <% booked   = match.total_players %>
                    <% capacity = match.hard_limit_total || 0 %>
                    <% ratio    = capacity.positive? ? (booked.to_f / capacity.to_f) : 0.0 %>
                    <% full     = capacity.positive? && booked >= capacity %>

                    <% already_registered =
                         if user_signed_in?
                           match.registrations.where(user_id: current_user.id).exists? ||
                             match.registrations.where(user_team_id: current_user.user_teams.select(:id)).exists?
                         else
                           false
                         end %>

                    <% disabled = full || already_registered %>

                    <div class="rounded-xl border border-slate-800 bg-slate-900/80 px-2 py-2 flex flex-col gap-1 min-w-0">
                      <div class="flex justify-between gap-2 min-w-0">
                        <p class="text-[11px] font-semibold text-slate-100 truncate min-w-0">
                          <%= match.title %>
                        </p>
                        <% if match.time %>
                          <span class="font-mono text-[10px] text-slate-300 shrink-0">
                            <%= match.time.strftime("%H:%M") %>
                          </span>
                        <% end %>
                      </div>

                      <p class="text-[10px] text-slate-400 truncate">
                        <%= match.city.name %>
                        <% if match.location.present? %> · <%= match.location.name %><% end %>
                      </p>

                      <!-- Actions: stack nicely on narrow widths -->
                      <div class="pt-0.5 flex flex-col gap-1">
                        <button
                          type="button"
                          class="inline-flex items-center justify-center rounded-full px-2 py-1 text-[10px] font-semibold whitespace-nowrap <%= disabled ? 'text-slate-300 bg-slate-800 cursor-not-allowed' : 'text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 hover:from-orange-300 hover:to-pink-400' %>"
                          <% unless disabled %>
                            data-open-register-modal
                            data-match-id="<%= match.id %>"
                            data-match-title="<%= match.title %>"
                            data-match-city="<%= match.city.name %>"
                            data-match-datetime="<%= [
                              (l(match.date, format: :short) rescue match.date.to_s),
                              (match.time&.strftime('%H:%M'))
                            ].compact.join(' · ') %>"
                            data-user-signed-in="<%= user_signed_in? %>"
                          <% end %>>
                          <% if full %>
                            Fullbokat
                          <% elsif already_registered %>
                            <span class="hidden sm:inline">Redan anmäld</span>
                            <span class="sm:hidden">Anmäld</span>
                          <% else %>
                            Boka
                          <% end %>
                        </button>

                        <%= link_to match_path(match),
                                    class: "text-[10px] text-slate-400 hover:text-orange-300 inline-flex items-center gap-1 self-start" do %>
                          <span class="hidden sm:inline">Detaljer</span>
                          <span class="sm:hidden">ℹ︎</span>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>

              </div>
            <% end %>
          </div>
        </div>

        <% if @matches_by_date.blank? %>
          <p class="text-xs text-slate-400 pl-1">
            Inga matcher hittades för den här perioden, men kalendern ligger kvar så du kan bläddra vidare.
          </p>
        <% end %>
      <% end %>
    </section>

    <!-- Logged-in: Register for match modal -->
    <div id="register-modal"
         class="fixed inset-0 w-screen h-screen z-50 hidden opacity-0 pointer-events-none transition-opacity duration-300 js-calendar-modal">
      <div class="fixed inset-0 w-screen h-screen bg-gradient-to-br from-black/80 via-slate-950/70 to-black/80 backdrop-blur-md transition-opacity duration-300"
           data-modal-dismiss></div>

      <div class="absolute inset-0 flex items-center justify-center px-4">
        <div id="register-modal-content"
             class="w-full max-w-md rounded-2xl border border-slate-700/70 bg-slate-950 p-5 shadow-xl scale-95 opacity-0 transition-all duration-300">
          <div class="flex items-center justify-between mb-3">
            <div>
              <p class="text-[11px] uppercase tracking-[0.18em] text-orange-300 mb-1">
                Anmälan
              </p>
              <h3 class="text-sm font-semibold text-slate-100" id="register-modal-title">
                Registrera dig till match
              </h3>
              <p class="text-[11px] text-slate-400 mt-0.5" id="register-modal-meta"></p>
            </div>

            <button type="button"
                    class="text-slate-400 hover:text-slate-200 text-sm"
                    data-modal-dismiss>
              ✕
            </button>
          </div>

          <p class="text-xs text-slate-400 mb-4">
            Välj om du vill anmäla dig som individuell spelare eller med ett lag.
          </p>

          <%= form_with url: registrations_path,
                        method: :post,
                        local: true,
                        html: { id: "register-match-form" } do |f| %>
            <%= hidden_field_tag :match_id, nil, id: "register-match-id" %>

            <div class="space-y-3 text-sm">
              <div>
                <label class="block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-400 mb-1">
                  Typ av anmälan
                </label>
                <div class="grid grid-cols-2 gap-2 text-[11px]">
                  <button type="button"
                          class="js-register-type-btn rounded-xl border border-slate-700 bg-slate-900/70 px-3 py-2 text-left text-slate-200 hover:border-orange-400 data-[active=true]:border-orange-400 data-[active=true]:bg-slate-900"
                          data-type="individual"
                          data-active="true">
                    Individuell
                    <p class="text-[10px] text-slate-400">
                      Du kommer själv, vi placerar dig i lag.
                    </p>
                  </button>
                  <button type="button"
                          class="js-register-type-btn rounded-xl border border-slate-700 bg-slate-900/70 px-3 py-2 text-left text-slate-200 hover:border-orange-400 data-[active=true]:border-orange-400 data-[active=true]:bg-slate-900"
                          data-type="team"
                          data-active="false">
                    Lag
                    <p class="text-[10px] text-slate-400">
                      Du anmäler ett gäng (2–5 spelare).
                    </p>
                  </button>
                </div>
                <%= hidden_field_tag :registration_type, "individual", id: "register-type-input" %>
              </div>

              <% if user_signed_in? %>
                <div id="user-team-wrapper" class="hidden mt-1">
                  <label class="block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-400 mb-1">
                    Välj lag
                  </label>
                  <% if @user_teams.present? %>
                    <select name="user_team_id"
                            id="user-team-select"
                            class="w-full rounded-xl border border-slate-700 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 focus:outline-none focus:ring-2 focus:ring-orange-400/70"
                            data-user-team-select>
                      <% @user_teams.each do |ut| %>
                        <option value="<%= ut.id %>"
                                data-member-count="<%= ut.members.count %>"
                                data-members="<%= ut.members.map { |m| { id: m.id, name: m.name_or_email } }.to_json %>">
                          <%= ut.name %> (<%= ut.members.count %> medlemmar)
                          <% if ut.creator?(current_user) %>
                            (skapare)
                          <% end %>
                        </option>
                      <% end %>
                    </select>
                    <p class="text-[10px] text-slate-500 mt-1">
                      Lag listas från din dashboard. Lägg till fler lag där.
                    </p>
                  <% else %>
                    <p class="text-[11px] text-slate-400">
                      Du har inga lag ännu. Skapa ett lag på din dashboard för att kunna anmäla ett lag.
                    </p>
                  <% end %>
                </div>
              <% end %>

              <div id="team-size-wrapper" class="hidden">
                <label class="block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-400 mb-1">
                  Antal spelare som kommer
                </label>
                <%= number_field_tag :team_size,
                                    nil,
                                    min: 1,
                                    max: 10,
                                    readonly: true,
                                    class: "w-full rounded-xl border border-slate-700 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 focus:outline-none focus:ring-2 focus:ring-orange-400/70 cursor-default",
                                    id: "team-size-input" %>
                <p class="text-[10px] text-slate-500 mt-1" id="team-size-help"></p>
              </div>

              <div id="team-members-wrapper" class="hidden mt-2">
                <label class="block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-400 mb-1">
                  Spelare i laget
                </label>
                <p class="text-[10px] text-slate-500 mb-1">
                  Markera vilka spelare som <span class="font-semibold text-slate-300">kommer</span>. Avmarkera de som inte kan komma. Antalet kryssade spelare styr automatiskt antalet platser.
                </p>
                <div id="team-members-list" class="space-y-1 text-[11px] text-slate-100">
                </div>
              </div>

              <div>
                <label class="block text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-400 mb-1">
                  Kommentar (valfritt)
                </label>
                <%= text_area_tag :note,
                                  nil,
                                  rows: 3,
                                  class: "w-full rounded-xl border border-slate-700 bg-slate-900/70 px-3 py-2 text-sm text-slate-50 focus:outline-none focus:ring-2 focus:ring-orange-400/70",
                                  placeholder: "T.ex. vilka i laget som inte kan, nivå, önskemål…" %>
              </div>
            </div>

            <div class="mt-4 flex justify-end gap-3">
              <button type="button"
                      class="text-[11px] text-slate-400 hover:text-slate-200"
                      data-modal-dismiss>
                Avbryt
              </button>

              <%= f.submit "Skicka anmälan",
                           class: "inline-flex items-center justify-center rounded-full px-4 py-2 text-[11px] font-semibold text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 shadow-lg hover:from-orange-300 hover:to-pink-400 transition" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Guest: Auth required modal -->
    <div id="auth-required-modal"
         class="fixed inset-0 w-screen h-screen z-50 hidden opacity-0 pointer-events-none transition-opacity duration-300 js-calendar-modal">
      <div class="fixed inset-0 w-screen h-screen bg-gradient-to-br from-black/85 via-slate-950/70 to-black/85 backdrop-blur-md transition-opacity duration-300"
           data-modal-dismiss></div>

      <div class="absolute inset-0 flex items-center justify-center px-4">
        <div id="auth-required-modal-content"
             class="w-full max-w-md rounded-2xl border border-slate-700/70 bg-slate-950 p-5 shadow-xl scale-95 opacity-0 transition-all duration-300">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-semibold text-slate-100">
              Skapa konto för att boka
            </h3>
            <button type="button"
                    class="text-slate-400 hover:text-slate-200 text-sm"
                    data-modal-dismiss>
              ✕
            </button>
          </div>

          <p class="text-xs text-slate-300 mb-3">
            Du behöver ett Barnaboll-konto för att anmäla dig till matcher.
          </p>
          <p class="text-xs text-slate-400 mb-4">
            Med konto kan du se dina kommande matcher, bygga stats och få uppdateringar om nya sessions.
          </p>

          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mt-2">
            <%= link_to "Logga in",
                        new_user_session_path,
                        class: "inline-flex items-center justify-center rounded-full px-4 py-2 text-[11px] sm:text-xs font-semibold text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 shadow-lg hover:from-orange-300 hover:to-pink-400 transition" %>

            <%= link_to "Skapa konto",
                        new_user_registration_path,
                        class: "inline-flex items-center justify-center rounded-full px-4 py-2 text-[11px] sm:text-xs font-semibold text-slate-200 border border-slate-700 hover:border-pink-400 hover:bg-slate-900/60 transition" %>
          </div>

          <p class="mt-3 text-[10px] text-slate-500">
            Du kan fortfarande se alla matcher i kalendern utan konto.
          </p>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  @keyframes fadeInSlow { from { opacity: 0; } to { opacity: 1; } }
  @keyframes fadeOutSlow { from { opacity: 1; } to { opacity: 0; } }
  @keyframes modalZoomIn {
    0% { transform: scale(0.92); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }
</style>

<script>
function openCalendarModal(modal, content) {
  if (!modal || !content) return;
  modal.classList.remove("hidden", "pointer-events-none");
  modal.style.opacity = "1";
  modal.style.animation = "fadeInSlow 0.25s ease-out";
  content.style.animation = "modalZoomIn 0.25s ease-out forwards";
}

function closeCalendarModal(modal) {
  if (!modal) return;
  modal.style.animation = "fadeOutSlow 0.25s ease-in";
  modal.style.opacity = "0";
  modal.classList.add("pointer-events-none");
  setTimeout(function () { modal.classList.add("hidden"); }, 260);
}

function resetCalendarModals() {
  document.querySelectorAll(".js-calendar-modal").forEach(function (modal) {
    modal.classList.add("hidden", "pointer-events-none");
    modal.style.opacity = "0";
    modal.style.animation = "none";
  });
}

function initTeamRegistration() {
  const teamSelect         = document.getElementById('user-team-select');
  const teamSizeInput      = document.getElementById('team-size-input');
  const teamSizeHelp       = document.getElementById('team-size-help');
  const typeInput          = document.getElementById('register-type-input');
  const teamMembersWrapper = document.getElementById('team-members-wrapper');
  const teamMembersList    = document.getElementById('team-members-list');

  if (!teamSelect || !teamSizeInput || !teamSizeHelp || !teamMembersList) return;

  teamSizeInput.readOnly = true;
  teamSizeInput.addEventListener('wheel', function (e) { e.preventDefault(); });
  teamSizeInput.addEventListener('keydown', function (e) { e.preventDefault(); });

  function syncTeamSizeFromCheckboxes() {
    const checkedCount = teamMembersList.querySelectorAll('input[name="present_member_ids[]"]:checked').length;
    if (checkedCount > 0) teamSizeInput.value = checkedCount;
  }

  function buildMembersListFromSelection() {
    const selectedOption = teamSelect.options[teamSelect.selectedIndex];
    if (!selectedOption) return;

    const membersJson = selectedOption.dataset.members;
    let members = [];

    if (membersJson) {
      try { members = JSON.parse(membersJson); } catch (e) { members = []; }
    }

    teamMembersList.innerHTML = '';

    if (!members.length) {
      if (teamMembersWrapper) teamMembersWrapper.classList.add('hidden');
      teamSizeHelp.textContent = '';
      return;
    }

    members.forEach(function(member) {
      const row = document.createElement('label');
      row.className = "flex items-center gap-2 text-[11px] text-slate-100";

      const checkbox = document.createElement('input');
      checkbox.type = 'checkbox';
      checkbox.name = 'present_member_ids[]';
      checkbox.value = member.id;
      checkbox.checked = true;
      checkbox.className = "h-3 w-3 rounded border-slate-500 bg-slate-900";

      const nameSpan = document.createElement('span');
      nameSpan.textContent = member.name || ("Spelare " + member.id);

      row.appendChild(checkbox);
      row.appendChild(nameSpan);
      teamMembersList.appendChild(row);
    });

    if (teamMembersWrapper) teamMembersWrapper.classList.remove('hidden');

    const memberCount = members.length;
    teamSizeInput.value = memberCount;
    teamSizeInput.max   = memberCount;
    teamSizeHelp.textContent = `Antal medlemmar i laget: ${memberCount}. Avmarkera de som inte kan komma – vi uppdaterar antalet platser automatiskt.`;

    teamMembersList.addEventListener('change', syncTeamSizeFromCheckboxes);
    syncTeamSizeFromCheckboxes();
  }

  function updateTeamSizeFromSelection() {
    const selectedOption = teamSelect.options[teamSelect.selectedIndex];
    if (!selectedOption) return;

    const memberCountData = selectedOption.dataset.memberCount;
    if (memberCountData) {
      const memberCount = parseInt(memberCountData, 10);
      if (!isNaN(memberCount)) {
        teamSizeInput.value = memberCount;
        teamSizeInput.max   = memberCount;
        teamSizeHelp.textContent = `Antal medlemmar i laget: ${memberCount}. Avmarkera de som inte kan komma.`;
      }
    }

    buildMembersListFromSelection();
  }

  teamSelect.addEventListener('change', function() { updateTeamSizeFromSelection(); });

  document.querySelectorAll('.js-register-type-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (this.dataset.type === 'team') setTimeout(updateTeamSizeFromSelection, 50);
    });
  });

  if (typeInput && typeInput.value === 'team') updateTeamSizeFromSelection();
}

function initCalendarModals() {
  resetCalendarModals();

  var registerModal        = document.getElementById("register-modal");
  var registerModalContent = document.getElementById("register-modal-content");
  var authModal            = document.getElementById("auth-required-modal");
  var authModalContent     = document.getElementById("auth-required-modal-content");
  var teamMembersWrapperRef = document.getElementById("team-members-wrapper");
  var teamMembersListRef    = document.getElementById("team-members-list");

  [registerModal, authModal].forEach(function (modal) {
    if (!modal) return;
    modal.querySelectorAll("[data-modal-dismiss]").forEach(function (el) {
      el.addEventListener("click", function () { closeCalendarModal(modal); });
    });
  });

  document.querySelectorAll("[data-open-register-modal]").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var signedIn   = btn.dataset.userSignedIn === "true";
      var matchId    = btn.dataset.matchId;
      var title      = btn.dataset.matchTitle || "Match";
      var city       = btn.dataset.matchCity || "";
      var datetime   = btn.dataset.matchDatetime || "";
      var metaString = [city, datetime].filter(Boolean).join(" · ");

      if (signedIn) {
        if (!registerModal || !registerModalContent) return;

        var titleEl         = document.getElementById("register-modal-title");
        var metaEl          = document.getElementById("register-modal-meta");
        var idInput         = document.getElementById("register-match-id");
        var typeInput       = document.getElementById("register-type-input");
        var teamWrapper     = document.getElementById("team-size-wrapper");
        var userTeamWrapper = document.getElementById("user-team-wrapper");

        if (titleEl) titleEl.textContent = "Registrera dig till match";
        if (metaEl)  metaEl.textContent  = metaString;
        if (idInput) idInput.value       = matchId;

        if (typeInput) typeInput.value = "individual";
        if (teamWrapper) teamWrapper.classList.add("hidden");
        if (userTeamWrapper) userTeamWrapper.classList.add("hidden");
        if (teamMembersWrapperRef) teamMembersWrapperRef.classList.add("hidden");
        if (teamMembersListRef) teamMembersListRef.innerHTML = "";

        document.querySelectorAll(".js-register-type-btn").forEach(function (tbtn) {
          tbtn.dataset.active = (tbtn.dataset.type === "individual") ? "true" : "false";
        });

        openCalendarModal(registerModal, registerModalContent);
      } else {
        if (!authModal || !authModalContent) return;
        openCalendarModal(authModal, authModalContent);
      }
    });
  });

  document.querySelectorAll(".js-register-type-btn").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var selectedType       = btn.dataset.type;
      var typeInput          = document.getElementById("register-type-input");
      var teamWrapper        = document.getElementById("team-size-wrapper");
      var userTeamWrapper    = document.getElementById("user-team-wrapper");
      var teamMembersWrapper = document.getElementById("team-members-wrapper");

      document.querySelectorAll(".js-register-type-btn").forEach(function (b) {
        b.dataset.active = (b === btn) ? "true" : "false";
      });

      if (typeInput) typeInput.value = selectedType;

      if (selectedType === "team") {
        if (teamWrapper)        teamWrapper.classList.remove("hidden");
        if (userTeamWrapper)    userTeamWrapper.classList.remove("hidden");
        if (teamMembersWrapper) teamMembersWrapper.classList.remove("hidden");
      } else {
        if (teamWrapper)        teamWrapper.classList.add("hidden");
        if (userTeamWrapper)    userTeamWrapper.classList.add("hidden");
        if (teamMembersWrapper) teamMembersWrapper.classList.add("hidden");
      }
    });
  });
}

function initCityDropdown() {
  var wrapper = document.querySelector("[data-city-select-wrapper]");
  if (!wrapper) return;
  if (wrapper.dataset.bound === "true") return;
  wrapper.dataset.bound = "true";

  var button = wrapper.querySelector("[data-city-select-button]");
  var menu   = wrapper.querySelector("[data-city-select-menu]");
  var input  = wrapper.querySelector("#calendar-city-input");
  var form   = wrapper.closest("form");

  if (!button || !menu || !input || !form) return;

  button.addEventListener("click", function () { menu.classList.toggle("hidden"); });

  menu.querySelectorAll("[data-city-option]").forEach(function (opt) {
    opt.addEventListener("click", function () {
      var value = opt.dataset.value || "";
      var label = opt.dataset.label || "Alla städer";
      var color = opt.dataset.color || "#e5e7eb";

      input.value = value;

      var dot     = button.querySelector("[data-city-dot]");
      var labelEl = button.querySelector("[data-city-label]");

      if (dot)     dot.style.backgroundColor = color;
      if (labelEl) labelEl.textContent       = label;

      menu.classList.add("hidden");
      form.submit();
    });
  });

  document.addEventListener("click", function (e) {
    if (!wrapper.contains(e.target)) menu.classList.add("hidden");
  });
}

function initCalendarPageUI() {
  initCalendarModals();
  initCityDropdown();
  initTeamRegistration();
}

document.addEventListener("DOMContentLoaded", initCalendarPageUI);
document.addEventListener("turbo:load", initCalendarPageUI);
document.addEventListener("turbo:render", initCalendarPageUI);
</script>
