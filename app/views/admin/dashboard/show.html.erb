<div class="min-h-[calc(100vh-5rem)] bg-slate-950 text-slate-50">
  <div class="max-w-5xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-semibold mb-2">Dashboard</h1>
    <p class="text-sm text-slate-400">
      Här kan du lägga till mer detaljerad statistik eller rapporter framöver.
    </p>

    <%= link_to "Tillbaka till översikten",
                admin_root_path,
                class: "mt-4 inline-flex items-center rounded-full px-4 py-2 text-[11px] font-semibold border border-slate-700 hover:border-orange-400 hover:text-orange-300" %>
  </div>
</div>
