<div style="font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background:#020617; color:#e2e8f0; padding:24px;">
  <div style="max-width:480px;margin:0 auto;border-radius:20px;border:1px solid #1f2937;background:#020617;padding:32px;">
    
    <h1 style="font-size:20px;margin:0 0 12px;color:#f9fafb;">Din e-post uppdaterades</h1>

    <p style="font-size:14px;margin:0 0 12px;">
      Hej <strong><%= @email %></strong>,
    </p>

    <% if @resource.try(:unconfirmed_email?) %>
      <p style="font-size:14px;margin:0 0 12px;">
        Din e-post håller på att ändras till  
        <strong><%= @resource.unconfirmed_email %></strong>.
      </p>
    <% else %>
      <p style="font-size:14px;margin:0 0 12px;">
        Din e-post har ändrats till  
        <strong><%= @resource.email %></strong>.
      </p>
    <% end %>

    <p style="font-size:12px;color:#94a3b8;margin:0;">
      Om detta inte var du, kontakta support eller återställ ditt konto.
    </p>

  </div>
</div>
