<% content_for :title, "Admin – Dashboard" %>
<% content_for :meta_description, "Adminöversikt för Barnaboll – hantera användare och communityn." %>

<div class="min-h-[calc(100vh-5rem)] bg-slate-950 text-slate-50">
  <div class="max-w-5xl mx-auto px-4 py-8 space-y-6">
    <header class="flex items-center justify-between">
      <div>
        <p class="text-[11px] uppercase tracking-[0.2em] text-orange-300 mb-1">
          Admin
        </p>
        <h1 class="text-2xl font-semibold tracking-tight">Dashboard</h1>
        <p class="text-sm text-slate-400">
          Snabb överblick över Barnaboll-communityn.
        </p>
      </div>

      <%= link_to "Hantera användare",
                  admin_users_path,
                  class: "inline-flex items-center justify-center rounded-full px-5 py-2.5 text-xs sm:text-sm font-semibold text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 shadow-lg shadow-orange-900/40 hover:from-orange-300 hover:to-pink-400 transition" %>
    </header>

    <div class="grid gap-4 md:grid-cols-3">
      <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4">
        <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500 mb-1">
          Totalt antal användare
        </p>
        <p class="text-2xl font-semibold"><%= @users_count %></p>
      </div>

      <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4">
        <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500 mb-1">
          Admins
        </p>
        <p class="text-2xl font-semibold"><%= @admins_count %></p>
      </div>

      <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4">
        <p class="text-[11px] uppercase tracking-[0.18em] text-slate-500 mb-1">
          Inloggad som
        </p>
        <p class="text-sm font-medium"><%= current_user.name_or_email %></p>
        <p class="text-[11px] text-slate-400 mt-1">Admin: <%= current_user.admin? ? "Ja" : "Nej" %></p>
      </div>
    </div>

    <section class="border border-slate-800 rounded-2xl bg-slate-950/70 p-4">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-sm font-semibold text-slate-100">
          Senaste användare
        </h2>
        <%= link_to "Visa alla",
                    admin_users_path,
                    class: "text-[11px] text-orange-300 hover:text-orange-200" %>
      </div>

      <% if @recent_users.any? %>
        <div class="divide-y divide-slate-800">
          <% @recent_users.each do |user| %>
            <div class="flex items-center justify-between py-2 text-sm">
              <div>
                <p class="font-medium text-slate-50"><%= user.name_or_email %></p>
                <p class="text-[11px] text-slate-400">
                  Skapad <%= l(user.created_at, format: :short) %>
                  <% if user.admin? %> · <span class="text-orange-300 font-medium">Admin</span><% end %>
                </p>
              </div>
              <div class="flex items-center gap-2">
                <%= link_to "Visa",
                            admin_user_path(user),
                            class: "text-[11px] rounded-full border border-slate-700 px-3 py-1 hover:border-pink-400 hover:text-pink-300" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-slate-400">Inga användare ännu.</p>
      <% end %>
    </section>
  </div>
</div>
