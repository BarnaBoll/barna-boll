<header class="border-b border-slate-800/80 bg-slate-950/95 backdrop-blur sticky top-0 z-40">
  <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between gap-3">
    <!-- Brand -->
    <div class="flex items-center gap-2 min-w-0">
      <%= link_to root_path, class: "flex items-center gap-2 min-w-0" do %>
        <%= image_tag "barnaboll_logo.jpg",
                      alt: "Barnaboll logo",
                      class: "h-7 w-7 rounded-xl border border-slate-700 object-cover shadow-md shadow-slate-900/60" %>

        <div class="flex flex-col">
          <p class="text-sm font-semibold tracking-tight truncate">
            Barnaboll <span class="text-orange-300">Football</span>
          </p>
          <p class="text-[11px] text-slate-500 leading-tight">
            Winner-stays-on sessions
          </p>
        </div>
      <% end %>
    </div>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-5 text-xs">
      <!-- Public link, for everyone -->
      <%= link_to "Schema",
                   schedule_path,
                  class: "text-slate-300 hover:text-orange-300 #{'text-orange-300' if current_page?( schedule_path)}" %>

      <% if user_signed_in? %>
        <%= link_to "Dashboard",
                    authenticated_root_path,
                    class: "text-slate-300 hover:text-orange-300" %>

        <% if current_user.admin? %>
          <%= link_to "Admin",
                      admin_root_path,
                      class: "text-amber-300 hover:text-amber-200" %>
        <% end %>

        <%= link_to "Profile",
                    profile_path,
                    class: "rounded-full px-3 py-0.5 font-semibold text-slate-200 ring-1 ring-slate-600/70 hover:ring-orange-400 hover:bg-slate-900/60" %>
      <% else %>
        <%= link_to "Sign in",
                    new_user_session_path,
                    class: "text-slate-300 hover:text-orange-300" %>
        <%= link_to "Get started",
                    new_user_registration_path,
                    class: "ml-1 inline-flex items-center justify-center rounded-full px-3 py-1.5 text-[11px] font-semibold text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 hover:from-orange-300 hover:to-pink-400" %>
      <% end %>
    </nav>

    <!-- Mobile menu button -->
    <button
      id="mobile-nav-toggle"
      class="md:hidden inline-flex items-center justify-center rounded-full border border-slate-700/70 p-2 text-slate-200 hover:border-orange-400 hover:bg-slate-900/70"
      type="button"
      aria-label="Toggle navigation"
    >
      <%= image_tag "icons/menu.svg",
            class: "h-4 w-4",
            alt: "" %>
    </button>
  </div>

  <!-- Mobile nav panel -->
  <nav
    id="mobile-nav"
    class="md:hidden hidden border-t border-slate-800/80 bg-slate-950/98"
  >
    <div class="max-w-5xl mx-auto px-4 py-3 flex flex-col gap-2 text-xs">
      <!-- Public calendar link for everyone -->
      <%= link_to "Schema",
                   schedule_path,
                  class: "text-slate-200 hover:text-orange-300 #{'text-orange-300' if current_page?( schedule_path)}" %>

      <% if user_signed_in? %>
        <%= link_to "Dashboard",
                    authenticated_root_path,
                    class: "text-slate-200 hover:text-orange-300" %>

        <% if current_user.admin? %>
          <%= link_to "Admin",
                      admin_root_path,
                      class: "text-amber-300 hover:text-amber-200" %>
        <% end %>

        <%= link_to "Profile",
                    profile_path,
                    class: "mt-3 inline-flex items-center justify-center rounded-full px-3 py-1 text-xs font-semibold text-slate-200 ring-1 ring-slate-600/70 hover:ring-orange-400 hover:bg-slate-900/60" %>
      <% else %>
        <%= link_to "Home",
                    root_path,
                    class: "text-slate-200 hover:text-orange-300 #{'text-orange-300' if current_page?(root_path)}" %>
        <%= link_to "Sign in",
                    new_user_session_path,
                    class: "text-slate-200 hover:text-orange-300" %>
        <%= link_to "Get started",
                    new_user_registration_path,
                    class: "inline-flex items-center justify-center rounded-full px-3 py-1.5 text-[11px] font-semibold text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 hover:from-orange-300 hover:to-pink-400" %>
      <% end %>
    </div>
  </nav>
</header>
