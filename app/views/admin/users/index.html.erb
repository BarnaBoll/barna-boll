<div class="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-950/70">
  <table class="min-w-full text-sm">
    <thead class="bg-slate-950/80 border-b border-slate-800 text-[11px] uppercase tracking-[0.18em] text-slate-500">
      <tr>
        <th class="px-4 py-3 text-left">Namn</th>
        <th class="px-4 py-3 text-left">E-post</th>
        <th class="px-4 py-3 text-left">Admin</th>
        <th class="px-4 py-3 text-left">Bekräftad</th>
        <th class="px-4 py-3 text-left">Låst</th>
        <th class="px-4 py-3 text-left">Inloggningar</th>
        <th class="px-4 py-3 text-right">Åtgärder</th>
      </tr>
    </thead>

    <tbody class="divide-y divide-slate-800">
      <% @users.each do |user| %>
        <tr class="hover:bg-slate-900/40 transition">
          <td class="px-4 py-3 align-top font-medium text-slate-50"><%= user.name %></td>
          <td class="px-4 py-3 align-top text-slate-300"><%= user.email %></td>

          <td class="px-4 py-3 align-top">
            <% if user.admin? %>
              <span class="inline-flex items-center rounded-full border border-orange-400/60 bg-orange-500/10 px-2.5 py-0.5 text-[11px] text-orange-300">
                Admin
              </span>
            <% else %>
              <span class="text-[11px] text-slate-400">Nej</span>
            <% end %>
          </td>

          <td class="px-4 py-3 align-top">
            <% if user.confirmed_at.present? %>
              <span class="text-[11px] text-emerald-300">Ja</span>
            <% else %>
              <span class="text-[11px] text-slate-400">Nej</span>
            <% end %>
          </td>

          <td class="px-4 py-3 align-top">
            <% if user.access_locked? %>
              <span class="text-[11px] text-red-300">Låst</span>
            <% else %>
              <span class="text-[11px] text-slate-400">Nej</span>
            <% end %>
          </td>

          <td class="px-4 py-3 align-top text-[11px] text-slate-400"><%= user.sign_in_count %></td>

          <!-- ACTIONS DROPDOWN -->
          <td class="px-4 py-3 align-top text-right relative">
            <div class="relative inline-block text-left" data-action-menu>
              <!-- Kebab menu button -->
              <button
                type="button"
                class="p-2 rounded-full hover:bg-slate-800 transition"
                data-action-menu-button>
                ⋮
              </button>

              <!-- Dropdown menu -->
              <div
                class="hidden absolute right-0 mt-2 w-44 rounded-xl border border-slate-700 bg-slate-900 shadow-xl py-1 z-20"
                data-action-menu-dropdown>

                <%= link_to "Visa",
                            admin_user_path(user),
                            class: "block px-3 py-2 text-[12px] text-slate-200 hover:bg-slate-800 rounded-lg" %>

                <%= link_to "Redigera",
                            edit_admin_user_path(user),
                            class: "block px-3 py-2 text-[12px] text-slate-200 hover:bg-slate-800 rounded-lg" %>

                <% if user.access_locked? %>
                  <%= button_to "Lås upp",
                                unlock_admin_user_path(user),
                                method: :patch,
                                data: { confirm: "Låsa upp användaren?" },
                                form: { class: "block" },
                                class: "w-full text-left px-3 py-2 text-[12px] text-emerald-300 hover:bg-slate-800 rounded-lg" %>
                <% else %>
                  <%= button_to "Lås användare",
                                lock_admin_user_path(user),
                                method: :patch,
                                data: { confirm: "Är du säker? Användaren kommer inte kunna logga in." },
                                form: { class: "block" },
                                class: "w-full text-left px-3 py-2 text-[12px] text-red-300 hover:bg-slate-800 rounded-lg" %>
                <% end %>

                <%= button_to "Ta bort",
                              admin_user_path(user),
                              method: :delete,
                              data: { confirm: "PERMANENT radera användaren?" },
                              form: { class: "block" },
                              class: "w-full text-left px-3 py-2 text-[12px] text-red-400 hover:bg-red-500/10 rounded-lg" %>
              </div>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  document.querySelectorAll("[data-action-menu]").forEach(menu => {
    const btn = menu.querySelector("[data-action-menu-button]");
    const dropdown = menu.querySelector("[data-action-menu-dropdown]");

    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      dropdown.classList.toggle("hidden");
    });

    document.addEventListener("click", () => dropdown.classList.add("hidden"));
  });
});
</script>
