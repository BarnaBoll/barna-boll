<div class="mt-4 space-y-2 text-[11px] text-slate-400">
  <% if controller_name != "sessions" %>
    <div>
      <%= link_to "Redan användare? Logga in",
                  new_session_path(resource_name),
                  class: "text-orange-300 hover:text-orange-200 font-semibold" %>
    </div>
  <% end %>

  <% if devise_mapping.registerable? && controller_name != "registrations" %>
    <div>
      <%= link_to "Skapa ett konto",
                  new_registration_path(resource_name),
                  class: "text-orange-300 hover:text-orange-200 font-semibold" %>
    </div>
  <% end %>

  <% if devise_mapping.recoverable? && controller_name != "passwords" %>
    <div>
      <%= link_to "Glömt lösenord?",
                  new_password_path(resource_name),
                  class: "text-slate-400 hover:text-slate-200" %>
    </div>
  <% end %>

  <% if devise_mapping.confirmable? && controller_name != "confirmations" %>
    <div>
      <%= link_to "Skicka om bekräftelseinstruktioner",
                  new_confirmation_path(resource_name),
                  class: "text-slate-400 hover:text-slate-200" %>
    </div>
  <% end %>

  <% if devise_mapping.lockable? &&
        resource_class.unlock_strategy_enabled?(:email) &&
        controller_name != "unlocks" %>
    <div>
      <%= link_to "Skicka om upplåsningsinstruktioner",
                  new_unlock_path(resource_name),
                  class: "text-slate-400 hover:text-slate-200" %>
    </div>
  <% end %>
</div>
