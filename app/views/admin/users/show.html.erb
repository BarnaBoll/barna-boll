<% content_for :title, "Admin – #{@user.name_or_email}" %>
<% content_for :meta_description, "Detaljer för användaren #{@user.name_or_email} i Barnaboll admin." %>

<div class="min-h-[calc(100vh-5rem)] bg-slate-950 text-slate-50">
  <div class="max-w-4xl mx-auto px-4 py-8 space-y-6">
    <div class="flex items-center justify-between gap-4">
      <div>
        <p class="text-[11px] uppercase tracking-[0.2em] text-orange-300 mb-1">
          Admin · Användare
        </p>
        <h1 class="text-2xl font-semibold tracking-tight"><%= @user.name_or_email %></h1>
        <p class="text-sm text-slate-400">
          <%= @user.email %>
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-2">
        <%= link_to "Redigera",
                    edit_admin_user_path(@user),
                    class: "inline-flex items-center justify-center rounded-full px-5 py-2 text-[11px] sm:text-xs font-semibold text-slate-950 bg-gradient-to-r from-orange-400 to-pink-500 shadow-lg shadow-orange-900/40 hover:from-orange-300 hover:to-pink-400 transition" %>

        <%= button_to "Ta bort",
                      admin_user_path(@user),
                      method: :delete,
                      data: { confirm: "Är du säker på att du vill ta bort den här användaren?" },
                      class: "inline-flex items-center justify-center rounded-full px-4 py-2 text-[11px] font-semibold border border-red-500/60 text-red-300 hover:bg-red-500/10" %>
      </div>
    </div>

    <section class="grid gap-4 md:grid-cols-2">
      <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4 text-sm space-y-2">
        <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-[0.18em] mb-1">
          Konto
        </h2>
        <p><span class="text-slate-500 text-[11px]">Namn:</span> <span class="font-medium"><%= @user.name %></span></p>
        <p><span class="text-slate-500 text-[11px]">E-post:</span> <%= @user.email %></p>
        <p>
          <span class="text-slate-500 text-[11px]">Admin:</span>
          <%= @user.admin? ? "Ja" : "Nej" %>
        </p>
        <p>
          <span class="text-slate-500 text-[11px]">Bekräftad:</span>
          <%= @user.confirmed_at? ? l(@user.confirmed_at, format: :short) : "Nej" %>
        </p>
      </div>

      <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4 text-sm space-y-2">
        <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-[0.18em] mb-1">
          Aktivitet
        </h2>
        <p>
          <span class="text-slate-500 text-[11px]">Skapad:</span>
          <%= l(@user.created_at, format: :short) %>
        </p>
        <p>
          <span class="text-slate-500 text-[11px]">Senaste inloggning:</span>
          <%= @user.last_sign_in_at ? l(@user.last_sign_in_at, format: :short) : "—" %>
        </p>
        <p>
          <span class="text-slate-500 text-[11px]">Antal inloggningar:</span>
          <%= @user.sign_in_count %>
        </p>
      </div>
    </section>

    <section class="flex flex-wrap items-center gap-3 pt-2">
      <%= button_to(@user.admin? ? "Ta bort admin-roll" : "Gör till admin",
                    toggle_admin_admin_user_path(@user),
                    method: :patch,
                    class: "inline-flex items-center justify-center rounded-full px-4 py-2 text-[11px] font-semibold border border-slate-700 text-slate-200 hover:border-pink-400 hover:text-pink-300") %>

      <%= link_to "Tillbaka till listan",
                  admin_users_path,
                  class: "text-[11px] text-slate-400 hover:text-pink-300" %>
    </section>
  </div>
</div>
